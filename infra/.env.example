# Copia a infra/.env (está en .gitignore) y cambia TODOS los valores. Nunca subas infra/.env.
# Superusuario de Postgres: solo lo usa el script de inicialización de roles en el primer arranque.
POSTGRES_SUPERUSER_PASSWORD=cambia-esto-superusuario
# logyx_owner: dueño del esquema (Flyway + SystemTx)
DB_ADMIN_PASSWORD=cambia-esto-owner
# logyx_api: usuario de la aplicación, miembro solo de logyx_app (RLS)
DB_APP_PASSWORD=cambia-esto-api
# MinIO (en producción real usa un usuario con política limitada al bucket en LOGYX_S3_ACCESS_KEY/SECRET_KEY)
MINIO_ROOT_USER=logyx-minio
MINIO_ROOT_PASSWORD=cambia-esto-minio-largo
LOGYX_S3_BUCKET=logyx-documents
# LOGYX_S3_ACCESS_KEY=
# LOGYX_S3_SECRET_KEY=
# Puertos publicados en 127.0.0.1
WEB_PORT=8580
BACKEND_PORT=8680
# http local: false. Detrás de https: true (o quítalo)
COOKIE_SECURE=false
# Correo (V14): restablecer contraseña e invitaciones. STARTTLS en 587; con TLS directo (465) usa SMTP_TLS=true y
# SMTP_START_TLS=DISABLED. El remitente necesita SPF/DKIM/DMARC del dominio.
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USERNAME=cambia-esto
SMTP_PASSWORD=cambia-esto-smtp
SMTP_START_TLS=REQUIRED
SMTP_TLS=false
MAIL_FROM="OnCargo <no-reply@oncargo.tech>"
# Responder a (opcional): p. ej. soporte@oncargo.tech
MAIL_REPLY_TO=
# URL pública de la página /restablecer de la web (el correo agrega ?token=…)
PASSWORD_RESET_URL=http://localhost:8580/restablecer
# V24: URL pública de la web (enlaces de los correos de avisos, /baja y List-Unsubscribe). En producción, https.
WEB_URL=http://localhost:8580
# V24: clave HMAC-SHA256 del enlace de baja de los correos (≥ 32 caracteres; obligatoria, el backend no arranca sin
# ella). Genérala con: openssl rand -base64 48. Cambiarla invalida los enlaces de baja ya enviados.
LOGYX_UNSUBSCRIBE_SECRET=cambia-esto-por-una-clave-larga-de-48-caracteres
# Solo pruebas: true = no envía correos
# MAILER_MOCK=false

# Cobros (V24, ADR-0014): clave AES-256 de los datos de cobro del transportista (CCI, Yape/Plin). Obligatoria en
# producción; genérala con `openssl rand -base64 32` y respáldala (sin ella los datos guardados no se pueden leer).
LOGYX_PAYOUT_KEY=
# Emisor que figura en las liquidaciones y resúmenes internos (no son comprobantes SUNAT).
BILLING_ISSUER_NAME=OnCargo
BILLING_ISSUER_RUC=
