---
interface Props { title: string; subtitle?: string }
const { title, subtitle } = Astro.props;
---
<div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
  <div class="min-w-0">
    <h1 class="text-[26px] font-semibold leading-tight tracking-tight text-ink-900 sm:text-3xl">{title}</h1>
    {subtitle && <p class="mt-1 max-w-2xl text-sm text-ink-500">{subtitle}</p>}
  </div>
  <div class="flex flex-wrap items-center gap-2 [&>*]:max-sm:flex-1"><slot name="actions" /></div>
</div>
