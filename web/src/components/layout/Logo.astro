---
const { dark = false } = Astro.props;
---
<span class:list={['inline-flex items-center gap-2 font-semibold tracking-tight', dark ? 'text-white' : 'text-ink-900']}>
  <svg width="26" height="26" viewBox="0 0 32 32" aria-hidden="true">
    <rect width="32" height="32" rx="8" fill="#0B4F6C" />
    <path d="M9 9v11h8" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none" />
    <path d="M17 23l6-6 0 0" stroke="#10B981" stroke-width="3" stroke-linecap="round" fill="none" />
    <circle cx="23" cy="11" r="2.5" fill="#10B981" />
  </svg>
  <span class="text-lg">LOGYX</span>
</span>
