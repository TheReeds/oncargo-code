---
import Base from '@/layouts/Base.astro';
import Logo from './Logo.astro';
import UserMenu from './UserMenu';
import NotificationBell from '@/features/notifications/components/NotificationBell';
import { me } from '@/features/auth/server';
import { LayoutDashboard, FileText, CirclePlus, Truck, Store, Gavel, Warehouse, Menu, ShieldCheck, X, TriangleAlert, Radar } from '@lucide/astro';

interface Props { title: string; active: string; wide?: boolean }
const { title, active, wide = false } = Astro.props;
const session = Astro.locals.session!;
const user = await me(session.token);

const NAV = {
  PYME: [
    { id: 'panel', href: '/pyme', label: 'Panel', icon: LayoutDashboard },
    { id: 'solicitudes', href: '/pyme/solicitudes', label: 'Solicitudes', icon: FileText },
    { id: 'nueva', href: '/pyme/solicitudes/nueva', label: 'Nueva solicitud', icon: CirclePlus },
    { id: 'envios', href: '/pyme/envios', label: 'Envíos', icon: Truck },
    { id: 'incidencias', href: '/incidencias', label: 'Incidencias', icon: TriangleAlert },
  ],
  CARRIER: [
    { id: 'marketplace', href: '/transportista/marketplace', label: 'Cargas disponibles', icon: Store },
    { id: 'ofertas', href: '/transportista/ofertas', label: 'Mis ofertas', icon: Gavel },
    { id: 'flota', href: '/transportista/flota', label: 'Flota', icon: Warehouse },
    { id: 'envios', href: '/transportista/envios', label: 'Envíos', icon: Truck },
    { id: 'incidencias', href: '/incidencias', label: 'Incidencias', icon: TriangleAlert },
  ],
  OPERATOR: [
    { id: 'operador', href: '/operador', label: 'Panel de operación', icon: Radar },
    { id: 'operador-incidencias', href: '/operador/incidencias', label: 'Incidencias', icon: TriangleAlert },
  ],
} as const;
const items = NAV[(session.orgType as 'PYME' | 'CARRIER' | 'OPERATOR') ?? 'PYME'] ?? [];
const roleLabel = session.orgType === 'PYME' ? 'Cuenta PYME' : session.orgType === 'OPERATOR' ? 'Operador LOGYX' : 'Transportista';
---
<Base title={title}>
  <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-[60] focus:rounded-input focus:bg-white focus:px-3 focus:py-2">Saltar al contenido</a>
  <div class="flex min-h-screen">
    <aside id="sidebar" class="fixed inset-y-0 left-0 z-30 flex w-64 -translate-x-full flex-col bg-ink-900 text-white shadow-xl transition-transform duration-200 lg:sticky lg:top-0 lg:h-screen lg:w-60 lg:translate-x-0 lg:shadow-none" aria-label="Navegación principal">
      <div class="flex h-14 items-center justify-between px-5">
        <a href="/" aria-label="LOGYX inicio"><Logo dark /></a>
        <button id="menu-close" type="button" class="rounded-input p-1.5 text-white/70 hover:bg-white/10 hover:text-white lg:hidden" aria-label="Cerrar menú"><X size={18} /></button>
      </div>
      <nav class="flex-1 space-y-1 overflow-y-auto px-3 py-3">
        {items.map((it) => (
          <a href={it.href} aria-current={active === it.id ? 'page' : undefined}
            class:list={['group relative flex items-center gap-3 rounded-input px-3 py-2.5 text-sm font-medium transition-colors', active === it.id ? 'bg-petrol-700 text-white' : 'text-white/70 hover:bg-white/10 hover:text-white']}>
            {active === it.id && <span class="absolute -left-3 top-2 h-6 w-1 rounded-r bg-emerald-500" aria-hidden="true"></span>}
            <it.icon size={18} aria-hidden="true" /> {it.label}
          </a>
        ))}
      </nav>
      <div class="border-t border-white/10 p-4 text-xs text-white/60">
        <a href="/privacidad" class="rounded hover:text-white">Política de privacidad</a>
      </div>
    </aside>
    <div id="scrim" class="fixed inset-0 z-20 hidden bg-ink-900/40 lg:hidden"></div>

    <div class="flex min-w-0 flex-1 flex-col">
      <header class="sticky top-0 z-10 flex h-14 items-center gap-3 border-b border-steel-200 bg-surface/95 px-4 backdrop-blur lg:px-8">
        <button id="menu-btn" type="button" class="-ml-1 rounded-input p-2 text-ink-700 hover:bg-steel-100 lg:hidden" aria-label="Abrir menú" aria-controls="sidebar" aria-expanded="false"><Menu size={20} /></button>
        <div class="flex min-w-0 flex-1 items-center gap-2">
          <span class="truncate text-sm font-semibold text-ink-900">{user?.organizationName ?? 'Mi empresa'}</span>
          {user?.rucVerified && <span class="hidden shrink-0 items-center gap-1 rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700 sm:inline-flex"><ShieldCheck size={12} aria-hidden="true" /> Empresa verificada</span>}
        </div>
        <NotificationBell client:load />
        <UserMenu client:load name={user?.fullName ?? session.email} email={session.email} role={roleLabel} verified={!!user?.rucVerified} />
      </header>
      <main id="contenido" class:list={['mx-auto w-full flex-1 px-4 py-6 lg:px-8', wide ? 'max-w-[1600px]' : 'max-w-7xl']}>
        <slot />
      </main>
    </div>
  </div>
  <script>
    const sb = document.getElementById('sidebar')!;
    const scrim = document.getElementById('scrim')!;
    const btn = document.getElementById('menu-btn')!;
    const set = (open: boolean) => {
      sb.classList.toggle('-translate-x-full', !open);
      scrim.classList.toggle('hidden', !open);
      btn.setAttribute('aria-expanded', String(open));
      if (open) sb.querySelector<HTMLElement>('a, button')?.focus();
      else if (document.activeElement && sb.contains(document.activeElement)) btn.focus();
    };
    btn.addEventListener('click', () => set(sb.classList.contains('-translate-x-full')));
    scrim.addEventListener('click', () => set(false));
    document.getElementById('menu-close')!.addEventListener('click', () => set(false));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !sb.classList.contains('-translate-x-full')) set(false); });
  </script>
</Base>
