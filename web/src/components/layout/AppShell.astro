---
import Base from '@/layouts/Base.astro';
import Logo from './Logo.astro';
import UserMenu from './UserMenu';
import ThemeToggle from '@/components/ui/theme-toggle';
import LiveIndicator from '@/components/layout/LiveIndicator';
import CommandMenu from '@/components/layout/CommandMenu';
import NotificationBell from '@/features/notifications/components/NotificationBell';
import VerificationBanner from '@/components/domain/VerificationBanner';
import { me } from '@/features/auth/server';
import { can, deniedRouteNotice, roleLabel as personRoleLabel } from '@/lib/permissions';
import { ReadOnlyNotice } from '@/components/domain/ReadOnlyNotice';
import RequestAccessHost from '@/features/access/components/RequestAccessDialog';
import { LayoutDashboard, FileText, CirclePlus, Truck, Store, Gavel, Warehouse, Menu, ShieldCheck, X, TriangleAlert, Radar, Route, CalendarClock, Undo2, Sparkles, Search, BookmarkCheck, Building2, Building, Users, ScrollText, SlidersHorizontal, MapPinned, Handshake, CalendarRange, Scale, ShieldAlert } from '@lucide/astro';

interface Props { title: string; active: string; wide?: boolean }
const { title, active, wide = false } = Astro.props;
const session = Astro.locals.session!;
const user = await me(session.token);

type NavItem = { id: string; href: string; label: string; icon: typeof LayoutDashboard; /** Permiso requerido para mostrar la entrada (si falta, se oculta). */ needs?: 'OPERATE' };
type NavGroup = { label?: string; items: NavItem[] };
const NAV: Record<'PYME' | 'CARRIER' | 'OPERATOR', NavGroup[]> = {
  PYME: [
    { items: [{ id: 'panel', href: '/pyme', label: 'Panel', icon: LayoutDashboard }] },
    { label: 'Cargas', items: [
      { id: 'solicitudes', href: '/pyme/solicitudes', label: 'Solicitudes', icon: FileText },
      { id: 'nueva', href: '/pyme/solicitudes/nueva', label: 'Nueva solicitud', icon: CirclePlus, needs: 'OPERATE' },
      { id: 'viajes', href: '/pyme/viajes', label: 'Buscar viajes', icon: Search },
      { id: 'reservas', href: '/pyme/reservas', label: 'Mis reservas', icon: BookmarkCheck },
      { id: 'ofertas', href: '/pyme/ofertas', label: 'Ofertas', icon: Gavel },
      { id: 'plantillas', href: '/pyme/plantillas', label: 'Plantillas', icon: CalendarClock },
      { id: 'direcciones', href: '/pyme/direcciones', label: 'Mis direcciones', icon: MapPinned },
      { id: 'transportistas', href: '/pyme/transportistas', label: 'Transportistas', icon: Users },
    ] },
    { label: 'Seguimiento', items: [
      { id: 'envios', href: '/pyme/envios', label: 'Envíos', icon: Truck },
      { id: 'incidencias', href: '/incidencias', label: 'Incidencias', icon: TriangleAlert },
    ] },
  ],
  CARRIER: [
    { items: [{ id: 'panel', href: '/transportista', label: 'Tu actividad', icon: LayoutDashboard }] },
    { label: 'Encontrar cargas', items: [
      { id: 'marketplace', href: '/transportista/marketplace', label: 'Cargas disponibles', icon: Store },
      { id: 'retornos', href: '/transportista/retornos', label: 'Cargas de retorno', icon: Undo2 },
      { id: 'smart-load', href: '/transportista/smart-load', label: 'Smart Load', icon: Sparkles },
    ] },
    { label: 'Mi operación', items: [
      { id: 'ofertas', href: '/transportista/ofertas', label: 'Mis ofertas', icon: Gavel },
      { id: 'confirmaciones', href: '/transportista/confirmaciones', label: 'Confirmaciones', icon: Handshake },
      { id: 'viajes', href: '/transportista/viajes', label: 'Viajes', icon: CalendarClock },
      { id: 'envios', href: '/transportista/envios', label: 'Envíos', icon: Truck },
      { id: 'agenda', href: '/transportista/agenda', label: 'Agenda', icon: CalendarRange },
      { id: 'flota', href: '/transportista/flota', label: 'Flota', icon: Warehouse },
      { id: 'incidencias', href: '/incidencias', label: 'Incidencias', icon: TriangleAlert },
    ] },
  ],
  OPERATOR: [
    { items: [{ id: 'operador', href: '/operador', label: 'Panel de operación', icon: Radar }] },
    { label: 'Gestión', items: [
      { id: 'operador-solicitudes', href: '/operador/solicitudes', label: 'Solicitudes', icon: FileText },
      { id: 'operador-envios', href: '/operador/envios', label: 'Envíos', icon: Truck },
      { id: 'operador-incidencias', href: '/operador/incidencias', label: 'Incidencias', icon: TriangleAlert },
      { id: 'operador-ajustes', href: '/operador/ajustes', label: 'Ajustes', icon: Scale },
    ] },
    { label: 'Cuentas', items: [
      { id: 'operador-organizaciones', href: '/operador/organizaciones', label: 'Verificación', icon: Building2 },
      { id: 'operador-senales', href: '/operador/senales', label: 'Señales', icon: ShieldAlert },
    ] },
    { label: 'Control', items: [
      { id: 'operador-auditoria', href: '/operador/auditoria', label: 'Auditoría', icon: ScrollText },
      { id: 'operador-parametros', href: '/operador/parametros', label: 'Parámetros', icon: SlidersHorizontal },
    ] },
  ],
};
// Sección "Organización" (PYME y transportista): el perfil lo ve todo el mundo; Usuarios solo con MANAGE_USERS.
const orgGroup: NavGroup = { label: 'Organización', items: [
  { id: 'organizacion', href: '/organizacion', label: 'Perfil de la empresa', icon: Building },
  ...(can(session, 'MANAGE_USERS') ? [{ id: 'usuarios', href: '/organizacion/usuarios', label: 'Usuarios y roles', icon: Users }] : []),
] };
const baseGroups = NAV[(session.orgType as 'PYME' | 'CARRIER' | 'OPERATOR') ?? 'PYME'] ?? [];
const withOrg = session.orgType === 'PYME' || session.orgType === 'CARRIER' ? [...baseGroups, orgGroup] : baseGroups;
const groups = withOrg.map((g) => ({ ...g, items: g.items.filter((it) => !it.needs || can(session, it.needs)) }));
const commandItems = groups.flatMap((g) => g.items.map((it) => ({ label: it.label, href: it.href, group: g.label ?? 'Principal' })));
const orgLabel = session.orgType === 'PYME' ? 'Cuenta PYME' : session.orgType === 'OPERATOR' ? 'Operador OnCargo' : 'Transportista';
// Rol de la persona (roadmap v2 1.7): «Administrador», «Operaciones» o «Lector», visible en el topbar y en el menú.
const personRole = personRoleLabel(session.role ?? 'ADMIN');
// Vuelta de una página de escritura sin permiso (`middleware.ts`, `WRITE_ROUTES`): aviso con «Pedir acceso».
const denied = deniedRouteNotice(Astro.url.searchParams.get('sinPermiso'));
// «Pedir acceso» global (toasts de AUTH-007, menú): solo quien no es ADMIN.
const mayRequestAccess = session.role !== 'ADMIN' && session.role !== null;
---
<Base title={title}>
  <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-[60] focus:rounded-input focus:bg-surface focus:text-ink-900 focus:px-3 focus:py-2">Saltar al contenido</a>
  <div class="flex min-h-screen">
    <aside id="sidebar" class="fixed inset-y-0 left-0 z-30 flex w-64 -translate-x-full flex-col bg-chrome text-white shadow-xl transition-transform duration-200 lg:sticky lg:top-0 lg:h-screen lg:w-60 lg:translate-x-0 lg:shadow-none" aria-label="Navegación principal">
      <div class="flex h-14 items-center justify-between px-5">
        <a href="/" aria-label="LOGYX inicio"><Logo dark /></a>
        <button id="menu-close" type="button" class="rounded-input p-1.5 text-white/70 hover:bg-white/10 hover:text-white lg:hidden" aria-label="Cerrar menú"><X size={18} /></button>
      </div>
      <nav class="flex-1 overflow-y-auto px-3 py-2" aria-label="Secciones">
        {groups.map((g) => (
          <div class="mb-3">
            {g.label && <p class="px-3 pb-1 pt-2 text-[11px] font-semibold uppercase tracking-wider text-white/65">{g.label}</p>}
            <ul class="space-y-0.5">
              {g.items.map((it) => (
                <li>
                  <a href={it.href} aria-current={active === it.id ? 'page' : undefined}
                    class:list={['group relative flex items-center gap-3 rounded-input px-3 py-2 text-sm font-medium transition-colors', active === it.id ? 'bg-petrol-700 text-on-solid' : 'text-white/70 hover:bg-white/10 hover:text-white']}>
                    {active === it.id && <span class="absolute -left-3 top-2 h-5 w-1 rounded-r bg-emerald-500" aria-hidden="true"></span>}
                    <it.icon size={17} aria-hidden="true" /> {it.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
      <div class="space-y-3 border-t border-white/10 p-4 text-xs text-white/60">
        <div class="sm:hidden"><ThemeToggle client:load className="w-full justify-between" /></div>
        <div class="flex items-center justify-between">
          <span class="font-medium text-white/80" data-testid="sidebar-role">{orgLabel} · {personRole}</span>
          <a href="/privacidad" class="rounded hover:text-white">Privacidad</a>
        </div>
      </div>
    </aside>
    <div id="scrim" class="fixed inset-0 z-20 hidden bg-scrim lg:hidden"></div>

    <div class="flex min-w-0 flex-1 flex-col">
      <header id="app-topbar" class="sticky top-0 z-10 flex h-14 items-center gap-2 border-b border-steel-200 bg-surface/95 px-3 backdrop-blur sm:gap-3 sm:px-4 lg:px-8">
        <button id="menu-btn" type="button" class="-ml-1 rounded-input p-2 text-ink-700 hover:bg-steel-100 lg:hidden" aria-label="Abrir menú" aria-controls="sidebar" aria-expanded="false"><Menu size={20} /></button>
        <div class="flex min-w-0 flex-1 items-center gap-2">
          <span class="truncate text-sm font-semibold text-ink-900">{user?.organizationName ?? 'Mi empresa'}</span>
          {user?.rucVerified && session.orgType !== 'OPERATOR' && <span class="hidden shrink-0 items-center gap-1 rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700 sm:inline-flex"><ShieldCheck size={12} aria-hidden="true" /> Verificado por OnCargo</span>}
        </div>
        <CommandMenu client:load items={commandItems} />
        <LiveIndicator client:load />
        <ThemeToggle client:load className="hidden sm:inline-flex" />
        <NotificationBell client:load />
        <UserMenu client:load name={user?.fullName ?? session.email} email={session.email} role={personRole} org={orgLabel} roleName={session.role ?? undefined} verified={!!user?.rucVerified && session.orgType !== 'OPERATOR'} />
      </header>
      <main id="contenido" class:list={['mx-auto w-full flex-1 px-4 py-6 lg:px-8', wide ? 'max-w-[1600px]' : 'max-w-7xl']}>
        {(session.orgType === 'PYME' || session.orgType === 'CARRIER') && user?.verificationStatus && user.verificationStatus !== 'VERIFIED' && (
          <VerificationBanner client:load status={user.verificationStatus} note={user.verificationNote ?? null} orgType={session.orgType} />
        )}
        {denied && !can(session, denied.needs) && (
          <ReadOnlyNotice client:load className="mb-4" permission={denied.needs}>{denied.notice}</ReadOnlyNotice>
        )}
        <slot />
      </main>
      {mayRequestAccess && <RequestAccessHost client:idle />}
    </div>
  </div>
  <style is:global>
    /* Transiciones entre documentos (guía `cross-document-transitions`): solo el contenido hace fundido; sidebar y topbar permanecen. */
    @media (prefers-reduced-motion: no-preference) {
      @view-transition { navigation: auto; }
      #sidebar { view-transition-name: lx-sidebar; }
      #app-topbar { view-transition-name: lx-topbar; }
      ::view-transition-old(root), ::view-transition-new(root) { animation-duration: 140ms; }
    }
  </style>
  <script>
    const sb = document.getElementById('sidebar')!;
    const scrim = document.getElementById('scrim')!;
    const btn = document.getElementById('menu-btn')!;
    const set = (open: boolean) => {
      sb.classList.toggle('-translate-x-full', !open);
      scrim.classList.toggle('hidden', !open);
      btn.setAttribute('aria-expanded', String(open));
      if (open) sb.querySelector<HTMLElement>('a, button')?.focus();
      else if (document.activeElement && sb.contains(document.activeElement)) btn.focus();
    };
    btn.addEventListener('click', () => set(sb.classList.contains('-translate-x-full')));
    scrim.addEventListener('click', () => set(false));
    document.getElementById('menu-close')!.addEventListener('click', () => set(false));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !sb.classList.contains('-translate-x-full')) set(false); });
  </script>
</Base>
