---
import { Building2, Truck, Check, ArrowRight, ShieldCheck, Timer } from '@lucide/astro';
import { Badge } from '@/components/ui/badge';
import { formatMoney, formatNumber } from '@/lib/format';
import { km, quote } from '../pricing';

const dist = km('LIMA', 'CUSCO');
const q = quote(dist, 2.4);
const pyme = [
  'Cotización estimada con desglose antes de publicar',
  'Hasta 5 ofertas por solicitud, con precio, vehículo y Trust Score',
  'Seguimiento por parada con foto de evidencia en la entrega',
  'Calificas al transportista cuando recibes tu carga',
];
const carrier = [
  'Cargas filtradas por ruta, fecha y capacidad de tus vehículos',
  'Ofertas con tu vehículo y precio, por encima del piso de la subasta',
  'Cargas de retorno y Smart Load para no viajar vacío',
  'Tu reputación crece con cada entrega y abre más cargas',
];
const kpis = [['Ofertas por revisar', '4'], ['En tránsito', '2'], ['Entregados del mes', '12']];
---
<section id="para-quien" class="relative bg-steel-100 pt-12 lg:pt-40" aria-labelledby="para-quien-t">
  <div class="mx-auto w-full max-w-[1280px] px-4 pb-12 lg:px-10 lg:pb-16">
    <div class="grid gap-3 lg:grid-cols-[1.1fr_0.9fr] lg:items-end lg:gap-12">
      <div class="mk-rv">
        <p class="mk-eyebrow">Para quién</p>
        <h2 id="para-quien-t" class="mk-h2 mt-3 text-ink-900">Dos lados del mismo envío, <span class="text-petrol-700">un solo lugar</span> para coordinarlo</h2>
      </div>
      <p class="mk-lead mk-rv text-base text-ink-700 lg:text-lg" style="--i:1">Cada rol ve lo que necesita: la empresa decide, el transportista oferta y el conductor ejecuta.</p>
    </div>

    <div class="mt-8 grid gap-5 lg:grid-cols-2">
      <article class="mk-card mk-rv-l relative flex flex-col overflow-hidden rounded-card border border-steel-200 bg-surface p-6 sm:p-8">
        <span class="absolute inset-x-0 top-0 h-1 bg-petrol-700" aria-hidden="true"></span>
        <div class="flex items-center gap-3">
          <span class="grid size-12 place-items-center rounded-input bg-petrol-700 text-on-solid"><Building2 size={24} aria-hidden="true" /></span>
          <p class="mk-eyebrow !tracking-[0.14em]">Para empresas</p>
        </div>
        <h3 class="mt-5 text-balance text-2xl font-semibold tracking-tight text-ink-900 lg:text-[28px] lg:leading-tight">Publica tu carga y compara ofertas</h3>
        <p class="mt-2 max-w-prose text-pretty text-[15px] text-ink-700">Pensado para PYMEs que envían carga entre Lima y la sierra sur y quieren precio claro, sin cotizar por teléfono.</p>
        <ul class="mt-5 space-y-2.5 text-sm text-ink-700">
          {pyme.map((p) => <li class="flex items-start gap-2.5"><span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-emerald-50 text-emerald-700"><Check size={12} stroke-width={3} aria-hidden="true" /></span>{p}</li>)}
        </ul>
        <div class="mt-6 rounded-input border border-steel-200 bg-steel-100/70 p-3.5" aria-hidden="true">
          <p class="text-[11px] font-semibold uppercase tracking-[0.1em] text-ink-500">Tu panel · ejemplo ilustrativo</p>
          <div class="mt-2 grid grid-cols-3 gap-2">
            {kpis.map(([k, v]) => <div class="rounded-input border border-steel-200 bg-surface px-3 py-2"><p class="mk-num text-2xl font-semibold text-ink-900">{v}</p><p class="text-[11px] leading-tight text-ink-500">{k}</p></div>)}
          </div>
          <div class="mt-2 flex items-center justify-between gap-3 rounded-input border border-steel-200 bg-surface px-3 py-2.5 text-sm">
            <span class="min-w-0"><span class="block font-medium text-ink-900">Lima → Arequipa</span><span class="mk-num block text-xs text-ink-500">Envío en curso · Nazca · 14:40</span></span>
            <Badge tone="petrol">En tránsito</Badge>
          </div>
        </div>
        <div class="mt-auto pt-7"><a href="/registro" class="inline-flex h-12 w-full items-center justify-center gap-2 whitespace-nowrap rounded-input bg-petrol-700 px-6 text-[15px] font-semibold text-on-solid transition-colors hover:bg-petrol-800 sm:w-auto">Crear cuenta de empresa <ArrowRight size={16} class="shrink-0" aria-hidden="true" /></a></div>
      </article>

      <article class="mk-dark mk-card mk-rv-r relative flex flex-col overflow-hidden rounded-card border border-white/10 p-6 sm:p-8">
        <div class="mk-grid absolute inset-0" aria-hidden="true"></div>
        <div class="relative flex flex-1 flex-col">
          <div class="flex items-center gap-3">
            <span class="grid size-12 place-items-center rounded-input bg-emerald-500 text-chrome"><Truck size={24} aria-hidden="true" /></span>
            <p class="mk-eyebrow !tracking-[0.14em]">Para transportistas</p>
          </div>
          <h3 class="mt-5 text-balance text-2xl font-semibold tracking-tight lg:text-[28px] lg:leading-tight">Encuentra cargas que encajan con tu flota</h3>
          <p class="mt-2 max-w-prose text-pretty text-[15px] text-white/85">Para empresas de transporte que quieren llenar sus camiones, también en el viaje de regreso.</p>
          <ul class="mt-5 space-y-2.5 text-sm text-white/90">
            {carrier.map((p) => <li class="flex items-start gap-2.5"><span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-emerald-500/20 text-emerald-500"><Check size={12} stroke-width={3} aria-hidden="true" /></span>{p}</li>)}
          </ul>
          <div class="mt-6 rounded-input border border-white/15 bg-chrome/50 p-4 backdrop-blur-sm" aria-hidden="true">
            <div class="flex items-center justify-between gap-2"><p class="text-[11px] font-semibold uppercase tracking-[0.1em] text-white/75">Carga disponible · ejemplo ilustrativo</p><span class="inline-flex items-center gap-1 rounded-full bg-emerald-500/20 px-2 py-0.5 text-[11px] font-medium text-emerald-500"><ShieldCheck size={11} /> Compatible</span></div>
            <div class="mt-2 flex items-end justify-between gap-3">
              <div><p class="text-lg font-semibold">Lima → Cusco</p><p class="mk-num text-xs text-white/80">{formatNumber(dist, 1)} km · 2.4 t · Camión mediano</p></div>
              <div class="text-right"><p class="mk-num text-2xl font-semibold text-emerald-500">{formatMoney(q.suggested)}</p><p class="text-[11px] text-white/80">precio sugerido</p></div>
            </div>
            <div class="mt-3 flex items-center justify-between border-t border-white/15 pt-2.5 text-xs text-white/85"><span class="inline-flex items-center gap-1"><Timer size={12} /> Cierra en <span class="mk-num">8:20</span> min</span><span class="mk-num">2 de 5 ofertas</span></div>
          </div>
          <div class="mt-auto pt-7"><a href="/registro?tipo=transportista" class="inline-flex h-12 w-full items-center justify-center gap-2 whitespace-nowrap rounded-input bg-emerald-500 px-6 text-[15px] font-semibold text-chrome transition-colors hover:bg-emerald-500/90 sm:w-auto">Registrarme para ofertar <ArrowRight size={16} class="shrink-0" aria-hidden="true" /></a></div>
        </div>
      </article>
    </div>
  </div>
</section>
