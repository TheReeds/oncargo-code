---
/** Mapa del corredor (rutas reales) + cotizador. Sección oscura; el cotizador cruza el borde inferior hacia la siguiente sección. */
import { MapPin } from '@lucide/astro';
import CorridorExplorer from './CorridorExplorer';
import { CITIES, DIST_KM, CODES } from '../corridor-data';
import { formatNumber } from '@/lib/format';

let far = { km: 0, a: 0, b: 0 };
DIST_KM.forEach((row, i) => row.forEach((v, j) => { if (v > far.km) far = { km: v, a: i, b: j }; }));
const label = (i: number) => CITIES.find((c) => c.code === CODES[i])!.label;
const pairs = (CITIES.length * (CITIES.length - 1)) / 2;
const groups = [
  { t: 'Costa sur', cities: ['Lima', 'Ica', 'Nazca'] },
  { t: 'Sur peruano', cities: ['Arequipa', 'Moquegua', 'Tacna'] },
  { t: 'Altiplano y sierra', cities: ['Juliaca', 'Puno', 'Cusco', 'Abancay', 'Ayacucho'] },
];
---
<section id="corredor" class="mk-dark relative isolate z-10 pb-12 lg:pb-0" aria-labelledby="corredor-t">
  <div class="mk-grid absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="mx-auto w-full max-w-[1280px] px-4 py-12 lg:px-10 lg:pb-0 lg:pt-16">
    <CorridorExplorer client:idle>
      <div slot="intro" class="mk-rv">
        <p class="mk-eyebrow">Corredor Lima – Sierra Sur</p>
        <h2 id="corredor-t" class="mk-h2 mt-3">Cotiza tu flete de Lima a <span class="text-emerald-500">Arequipa, Cusco o Puno</span></h2>
        <p class="mk-lead mt-4 text-base text-white/85 lg:text-lg">Elige la ruta, el peso y el tipo de carga. El precio usa km por carretera e incluye peajes e IGV.</p>
      </div>
      <div slot="aside" class="mk-rv space-y-6" style="--i:1">
        <dl class="grid grid-cols-3 gap-4 border-t border-white/20 pt-5">
          <div class="flex flex-col-reverse justify-end"><dt class="mt-1 text-[13px] leading-snug text-white/80">ciudades conectadas</dt><dd class="mk-num text-2xl font-semibold sm:text-3xl lg:text-4xl"><span data-count={CITIES.length}>{CITIES.length}</span></dd></div>
          <div class="flex flex-col-reverse justify-end"><dt class="mt-1 text-[13px] leading-snug text-white/80">rutas cotizables</dt><dd class="mk-num text-2xl font-semibold sm:text-3xl lg:text-4xl"><span data-count={pairs}>{pairs}</span></dd></div>
          <div class="flex flex-col-reverse justify-end"><dt class="mt-1 text-[13px] leading-snug text-white/80">km de {label(far.a)} a {label(far.b)}</dt><dd class="mk-num text-2xl font-semibold sm:text-3xl lg:text-4xl"><span data-count={far.km} data-dec="1">{formatNumber(far.km, 1)}</span></dd></div>
        </dl>
        <ul class="flex flex-wrap gap-x-8 gap-y-3" aria-label="Ciudades por tramo">
          {groups.map((g) => (
            <li>
              <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-white/75">{g.t}</p>
              <ul class="mt-1.5 flex flex-wrap gap-1.5">
                {g.cities.map((c) => <li class="inline-flex items-center gap-1 rounded-full border border-white/20 bg-chrome/40 px-2.5 py-0.5 text-[13px] text-white"><MapPin size={11} class="shrink-0 text-emerald-500" aria-hidden="true" />{c}</li>)}
              </ul>
            </li>
          ))}
        </ul>
      </div>
    </CorridorExplorer>
  </div>
</section>

<style is:global>
  .cx-city { cursor: pointer; outline: none; }
  .cx-ring { stroke: transparent; }
  .cx-label { font-size: 15px; font-weight: 500; }
  .cx-label[data-active] { font-size: 17px; font-weight: 700; }
  @media (max-width: 640px) { .cx-label { font-size: 24px; } .cx-label[data-active] { font-size: 27px; } }
  .cx-city:hover .cx-ring { stroke: rgb(255 255 255 / 0.35); }
  .cx-city:focus-visible .cx-ring { stroke: white; }
  @media (prefers-reduced-motion: no-preference) {
    .cx-route { animation: cx-draw 1.1s cubic-bezier(0.4, 0, 0.2, 1) both; }
    @keyframes cx-draw { from { stroke-dasharray: 1; stroke-dashoffset: 1; } to { stroke-dasharray: 1; stroke-dashoffset: 0; } }
  }
</style>
