---
import { MapPin } from '@lucide/astro';
import { RouteLine } from '@/components/domain/RouteLine';
import SectionHeading from './SectionHeading.astro';

const groups = [
  { t: 'Costa sur', cities: ['Lima', 'Ica', 'Nazca'] },
  { t: 'Sur peruano', cities: ['Arequipa', 'Moquegua', 'Tacna'] },
  { t: 'Altiplano y sierra', cities: ['Juliaca', 'Puno', 'Cusco', 'Abancay', 'Ayacucho'] },
];
---
<section id="corredor" class="mx-auto w-full max-w-6xl px-4 py-14 lg:px-10 lg:py-20" aria-labelledby="corredor-t">
  <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:gap-14">
    <div>
      <SectionHeading id="corredor-t" eyebrow="Corredor Lima – Sierra Sur" title="Hecho para las rutas donde operan las PYMEs del sur" lead="Conocemos las distancias, los peajes y las paradas del corredor, por eso la cotización estimada llega al instante." />
      <div class="mt-7 max-w-md rounded-card border border-steel-200 bg-surface p-5">
        <p class="text-xs font-semibold uppercase tracking-wide text-ink-500">Ruta de referencia</p>
        <div class="mt-3"><RouteLine origin="LIMA" destination="JULIACA" km={1010} originSub="Recojo" destinationSub="Entrega" /></div>
      </div>
    </div>
    <ul class="grid gap-4 sm:grid-cols-3 lg:grid-cols-1">
      {groups.map((g) => (
        <li class="rounded-card border border-steel-200 bg-surface p-5">
          <h3 class="text-xs font-semibold uppercase tracking-wide text-ink-500">{g.t}</h3>
          <ul class="mt-3 flex flex-wrap gap-2">
            {g.cities.map((c) => <li class="inline-flex items-center gap-1.5 rounded-full bg-petrol-50 px-3 py-1 text-sm font-medium text-petrol-700"><MapPin size={13} aria-hidden="true" />{c}</li>)}
          </ul>
        </li>
      ))}
    </ul>
  </div>
</section>
