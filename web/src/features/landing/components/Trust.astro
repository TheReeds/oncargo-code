---
import { BadgeCheck, Star, Camera, MessagesSquare, Lock } from '@lucide/astro';
import { VerifiedBadge } from '@/components/domain/VerifiedBadge';
import { TrustScore } from '@/components/domain/TrustScore';
import { Avatar } from '@/components/ui/avatar';

// Sin testimonios: no hay clientes que citar todavía (CONTENT.md, «Prueba social»).
const items = [
  { icon: BadgeCheck, t: 'Empresas verificadas', d: 'Validamos el RUC y revisamos cada empresa antes de que publique u oferte.' },
  { icon: Star, t: 'Trust Score de 0 a 100', d: 'Puntualidad, estado de la carga y comunicación, calificados solo tras una entrega con foto.' },
  { icon: Camera, t: 'Entrega con foto', d: 'Si hay una incidencia, el envío se congela hasta que la resolvemos.' },
  { icon: MessagesSquare, t: 'Acuerdos registrados', d: 'El chat bloquea teléfonos y enlaces hasta adjudicar: todo lo pactado queda escrito.' },
];
---
<section id="confianza" class="border-t border-steel-200 bg-steel-100" aria-labelledby="confianza-t">
  <div class="mx-auto w-full max-w-[1280px] px-4 py-12 lg:px-10 lg:py-16">
    <div class="grid gap-3 lg:grid-cols-[1.1fr_0.9fr] lg:items-end lg:gap-12">
      <div class="mk-rv">
        <p class="mk-eyebrow">Confianza</p>
        <h2 id="confianza-t" class="mk-h2 mt-3 text-ink-900">Sabes con quién trabajas <span class="text-petrol-700">antes de aceptar</span></h2>
      </div>
    </div>

    <div class="mt-8 grid gap-4 lg:grid-cols-12 lg:gap-5">
      <figure class="mk-card mk-rv-l flex flex-col justify-between rounded-card border border-steel-200 bg-surface p-6 shadow-sm lg:col-span-5 lg:row-span-2" aria-label="Ejemplo ilustrativo de perfil de transportista">
        <div>
          <p class="mk-eyebrow !text-ink-500">Lo que ves antes de aceptar</p>
          <div class="mt-5 flex items-center gap-3">
            <Avatar name="Logística Altiplano" size="lg" />
            <div class="min-w-0">
              <p class="truncate text-lg font-semibold text-ink-900">Logística Altiplano S.A.C.</p>
              <div class="mt-1 flex flex-wrap items-center gap-2 text-xs text-ink-500"><span>Transportista · Juliaca</span><VerifiedBadge /></div>
            </div>
          </div>
          <div class="mt-6"><TrustScore variant="meter" score={86.4} reviews={38} /></div>
          <ul class="mt-6 space-y-3 text-sm" aria-label="Criterios del Trust Score">
            {[['Puntualidad', 90], ['Estado de la carga', 84], ['Comunicación', 85]].map(([k, v]) => (
              <li><div class="flex items-center justify-between"><span class="text-ink-700">{k}</span><span class="mk-num text-ink-900">{v}</span></div><div class="mt-1 h-1.5 overflow-hidden rounded-full bg-steel-200" aria-hidden="true"><div class="h-full rounded-full bg-petrol-700" style={`width:${v}%`}></div></div></li>
            ))}
          </ul>
          <ul class="mt-6 flex flex-wrap gap-2 text-xs"><li class="rounded-full bg-steel-100 px-2.5 py-1 text-ink-700">Camión mediano</li><li class="rounded-full bg-steel-100 px-2.5 py-1 text-ink-700">Camión grande</li><li class="rounded-full bg-steel-100 px-2.5 py-1 text-ink-700">Ruta Lima ⇄ Juliaca</li></ul>
        </div>
        <figcaption class="mt-6 border-t border-steel-200 pt-3 text-xs text-ink-500">Perfil de transportista · ejemplo ilustrativo</figcaption>
      </figure>

      <ul class="grid gap-4 sm:grid-cols-2 lg:col-span-7 lg:gap-5">
        {items.map((it, i) => (
          <li class="mk-card mk-rv rounded-card border border-steel-200 bg-surface p-5" style={`--i:${i}`}>
            <span class="grid size-10 place-items-center rounded-full bg-emerald-50 text-emerald-700"><it.icon size={20} aria-hidden="true" /></span>
            <h3 class="mt-3 font-semibold text-ink-900">{it.t}</h3>
            <p class="mt-1 text-pretty text-sm text-ink-700">{it.d}</p>
          </li>
        ))}
      </ul>
    </div>

    <div class="mk-rv mt-4 flex items-start gap-4 rounded-card border border-steel-200 bg-petrol-50 p-5 lg:mt-5 lg:items-center">
      <Lock size={22} class="mt-0.5 shrink-0 text-petrol-700 lg:mt-0" aria-hidden="true" />
      <div class="flex flex-1 flex-col gap-1 lg:flex-row lg:items-center lg:justify-between lg:gap-6">
        <div><h3 class="font-semibold text-ink-900">Tus datos, protegidos</h3><p class="mt-0.5 max-w-[70ch] text-pretty text-sm text-ink-700">Cumplimos la Ley 29733 y aislamos los datos de cada empresa.</p></div>
        <a href="/privacidad" class="shrink-0 text-sm font-medium text-petrol-700 underline underline-offset-2">Leer la política de privacidad</a>
      </div>
    </div>
  </div>
</section>
