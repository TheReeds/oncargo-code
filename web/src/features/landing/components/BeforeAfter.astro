---
import { X, Check, ArrowRight } from '@lucide/astro';
const rows = [
  { k: 'Cotizar', before: 'Llamas a varios transportistas y esperas respuesta por horas.', after: 'Publicas una vez y recibes hasta 5 ofertas en 20 minutos.' },
  { k: 'Precio', before: 'Cada llamada da un precio distinto y no hay referencia.', after: 'Cotización estimada con desglose y piso del 75 %: sabes qué es razonable.' },
  { k: 'Confianza', before: 'No sabes si la empresa existe ni cómo cumple.', after: 'RUC validado, sello «Verificado por OnCargo» y Trust Score de 0 a 100.' },
  { k: 'Acuerdos', before: 'Se pactan por chat o por teléfono, sin registro.', after: 'Contraofertas y chat dentro de la plataforma, con el acuerdo registrado.' },
  { k: 'Seguimiento', before: 'Llamas al conductor para saber dónde va.', after: 'Estado por parada y foto de evidencia al entregar.' },
];
---
<section class="bg-surface" aria-labelledby="antes-despues-t">
  <div class="mx-auto w-full max-w-[1280px] px-4 py-12 lg:px-10 lg:py-16">
    <div class="grid gap-3 lg:grid-cols-[0.8fr_1.2fr] lg:items-end lg:gap-12">
      <div class="mk-rv">
        <p class="mk-eyebrow">Antes y después</p>
        <h2 id="antes-despues-t" class="mk-h2 mt-3 text-ink-900">Del teléfono a una <span class="text-petrol-700">subasta con reglas</span></h2>
      </div>
      <p class="mk-lead mk-rv text-base text-ink-700 lg:text-lg" style="--i:1">Contratar un flete por el corredor suele ser una cadena de llamadas. Así cambia cada paso con OnCargo.</p>
    </div>

    <div class="mt-8 hidden grid-cols-[1fr_2.5rem_1.15fr] gap-x-3 px-1 pb-2 text-xs font-semibold uppercase tracking-[0.12em] md:grid">
      <p class="pl-1 text-ink-500">Sin OnCargo</p><span></span><p class="pl-5 text-petrol-700">Con OnCargo</p>
    </div>
    <ul class="mt-6 space-y-3 md:mt-0">
      {rows.map((r, i) => (
        <li class="mk-rv grid items-stretch gap-2 md:grid-cols-[1fr_2.5rem_1.15fr] md:gap-3" style={`--i:${i}`}>
          <div class="flex items-start gap-3 rounded-card border border-steel-200 bg-steel-100 p-4 text-ink-700 md:p-5">
            <span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-red-50 text-red-700"><X size={12} stroke-width={3} aria-hidden="true" /></span>
            <div><p class="text-xs font-semibold uppercase tracking-[0.1em] text-ink-500 md:hidden">Sin OnCargo · {r.k}</p><p class="mt-0.5 text-sm md:mt-0 md:text-[15px]"><span class="sr-only">Sin OnCargo: </span>{r.before}</p></div>
          </div>
          <span class="hidden place-items-center text-ink-400 md:grid" aria-hidden="true"><ArrowRight size={20} /></span>
          <div class="mk-card flex items-start gap-3 rounded-card border border-emerald-700/25 bg-emerald-50 p-4 text-ink-900 md:p-5">
            <span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-emerald-700 text-on-solid"><Check size={12} stroke-width={3} aria-hidden="true" /></span>
            <div><p class="text-xs font-semibold uppercase tracking-[0.1em] text-emerald-700 md:hidden">Con OnCargo · {r.k}</p><p class="mt-0.5 text-sm font-medium md:mt-0 md:text-[15px]"><span class="sr-only">Con OnCargo: </span>{r.after}</p></div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
