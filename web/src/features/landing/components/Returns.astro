---
import { Repeat2, Layers, ArrowRight } from '@lucide/astro';
import SectionHeading from './SectionHeading.astro';

const feats = [
  { icon: Repeat2, t: 'Cargas de retorno', d: 'Al entregar en una ciudad, te mostramos solicitudes que salen a menos de 50 km, con recojo en los próximos 7 días y que caben en tu vehículo.' },
  { icon: Layers, t: 'Smart Load', d: 'Agrupamos 2 o más cargas compatibles (orígenes a menos de 50 km, destinos a menos de 80 km, con un día de diferencia) para llenar tu camión desde el 60 %.' },
];
---
<section id="retornos" class="mx-auto w-full max-w-6xl px-4 py-14 lg:px-10 lg:py-20" aria-labelledby="retornos-t">
  <div class="relative overflow-hidden rounded-card bg-chrome px-6 py-10 text-white sm:px-10 sm:py-12 lg:px-12 lg:py-14">
    <div class="lp-grid-dark absolute inset-0" aria-hidden="true"></div>
    <div class="relative grid gap-10 lg:grid-cols-[1fr_1fr] lg:items-center lg:gap-14">
      <div>
        <SectionHeading id="retornos-t" invert eyebrow="Para transportistas" title="Que tu camión no vuelva vacío" lead="Menos kilómetros sin carga significa más ingreso por viaje. OnCargo te sugiere cómo completar la capacidad de tu vehículo." />
        <ul class="mt-8 space-y-6">
          {feats.map((f) => (
            <li class="flex gap-4">
              <span class="grid size-10 shrink-0 place-items-center rounded-input bg-white/10 text-emerald-500"><f.icon size={20} aria-hidden="true" /></span>
              <div><h3 class="font-semibold">{f.t}</h3><p class="mt-1 text-pretty text-sm text-white/70">{f.d}</p></div>
            </li>
          ))}
        </ul>
        <a href="/registro?tipo=transportista" class="mt-8 inline-flex h-11 items-center gap-2 rounded-input bg-emerald-500 px-6 text-base font-medium text-chrome transition-colors hover:bg-emerald-500/90">Registrar mi flota <ArrowRight size={16} aria-hidden="true" /></a>
      </div>

      <div class="space-y-4" role="group" aria-label="Ejemplos ilustrativos de Smart Load y carga de retorno">
        <div class="rounded-card border border-white/15 bg-white/5 p-5">
          <div class="flex items-center justify-between gap-2"><p class="text-xs font-semibold uppercase tracking-wide text-white/70">Smart Load</p><span class="rounded-full bg-emerald-500/15 px-2.5 py-0.5 text-xs font-medium text-emerald-500">2 cargas compatibles</span></div>
          <ul class="mt-4 space-y-2 text-sm">
            <li class="flex items-center justify-between gap-3"><span class="flex items-center gap-2"><span class="size-2.5 rounded-sm bg-petrol-700 ring-1 ring-white/30" aria-hidden="true"></span>Carga A · Lima → Arequipa</span><span class="font-mono tabular-nums text-white/70">1.8 t</span></li>
            <li class="flex items-center justify-between gap-3"><span class="flex items-center gap-2"><span class="size-2.5 rounded-sm bg-emerald-500" aria-hidden="true"></span>Carga B · Lima → Arequipa</span><span class="font-mono tabular-nums text-white/70">1.5 t</span></li>
          </ul>
          <div class="mt-4 flex h-2.5 overflow-hidden rounded-full bg-white/15" role="meter" aria-label="Ocupación del camión" aria-valuemin={0} aria-valuemax={5} aria-valuenow={3.3} aria-valuetext="3.3 de 5 toneladas">
            <span class="h-full bg-petrol-700 ring-1 ring-inset ring-white/30" style="width:36%"></span><span class="h-full bg-emerald-500" style="width:30%"></span>
          </div>
          <p class="mt-1.5 flex justify-between font-mono text-xs tabular-nums text-white/70"><span>3.3 / 5 t · Camión mediano</span><span>66 %</span></p>
        </div>
        <div class="rounded-card border border-white/15 bg-white/5 p-5">
          <div class="flex items-center justify-between gap-2"><p class="text-xs font-semibold uppercase tracking-wide text-white/70">Carga de retorno</p><span class="rounded-full bg-emerald-500/15 px-2.5 py-0.5 text-xs font-medium text-emerald-500">Compatible</span></div>
          <p class="mt-3 text-sm text-white/70">Entregas en <span class="font-medium text-white">Juliaca</span> el 30 nov. Sugerida para tu regreso:</p>
          <div class="mt-3 flex items-center justify-between gap-3 rounded-input bg-white/5 px-3 py-2.5">
            <span class="font-medium">Juliaca → Lima</span>
            <span class="font-mono text-xs tabular-nums text-white/70">Recojo 1 dic · 2.4 t</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
