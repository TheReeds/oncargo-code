---
import { Repeat2, Layers, ArrowRight, Truck } from '@lucide/astro';
import { formatNumber } from '@/lib/format';
import { km } from '../pricing';

const back = km('JULIACA', 'LIMA');
const feats = [
  { icon: Repeat2, t: 'Cargas de retorno', d: 'Al entregar en una ciudad, te mostramos solicitudes que salen a menos de 50 km, con recojo en los próximos 7 días y que caben en tu vehículo.' },
  { icon: Layers, t: 'Smart Load', d: 'Agrupamos 2 o más cargas compatibles (orígenes a menos de 50 km, destinos a menos de 80 km, con un día de diferencia) para llenar tu camión desde el 60 %.' },
];
---
<section id="retornos" class="bg-surface" aria-labelledby="retornos-t">
  <div class="mx-auto grid w-full max-w-[1280px] items-center gap-10 px-4 py-12 lg:grid-cols-[0.95fr_1.05fr] lg:gap-16 lg:px-10 lg:py-16">
    <div>
      <div class="mk-rv">
        <p class="mk-eyebrow">Para transportistas</p>
        <h2 id="retornos-t" class="mk-h2 mt-3 text-ink-900">Que tu camión <span class="text-petrol-700">no vuelva vacío</span></h2>
        <p class="mk-lead mt-4 text-base text-ink-700 lg:text-lg">Menos kilómetros sin carga significa más ingreso por viaje. OnCargo te sugiere cómo completar la capacidad de tu vehículo.</p>
      </div>
      <ul class="mt-7 space-y-4">
        {feats.map((f, i) => (
          <li class="mk-card mk-rv flex gap-4 rounded-card border border-steel-200 bg-steel-100/60 p-4 sm:p-5" style={`--i:${i}`}>
            <span class="grid size-11 shrink-0 place-items-center rounded-input bg-petrol-700 text-on-solid"><f.icon size={22} aria-hidden="true" /></span>
            <div><h3 class="font-semibold text-ink-900">{f.t}</h3><p class="mt-1 text-pretty text-sm text-ink-700">{f.d}</p></div>
          </li>
        ))}
      </ul>
      <a href="/registro?tipo=transportista" class="mt-7 inline-flex h-12 items-center gap-2 whitespace-nowrap rounded-input bg-emerald-700 px-6 text-[15px] font-semibold text-on-solid transition-colors hover:bg-emerald-700/90">Registrar mi flota <ArrowRight size={16} class="shrink-0" aria-hidden="true" /></a>
    </div>

    <div class="relative" role="group" aria-label="Ejemplos ilustrativos de Smart Load y carga de retorno">
      <div class="mk-dark mk-rv-r relative overflow-hidden rounded-card p-5 shadow-xl sm:p-6">
        <div class="mk-grid absolute inset-0" aria-hidden="true"></div>
        <div class="relative">
          <div class="flex items-center justify-between gap-2"><p class="text-xs font-semibold uppercase tracking-[0.1em] text-white/80">Smart Load · ejemplo ilustrativo</p><span class="rounded-full bg-emerald-500/20 px-2.5 py-0.5 text-xs font-medium text-emerald-500">2 cargas compatibles</span></div>
          <ul class="mt-4 space-y-2.5 text-sm">
            <li class="flex items-center justify-between gap-3 rounded-input bg-white/5 px-3 py-2.5"><span class="flex items-center gap-2"><span class="size-2.5 rounded-sm bg-[var(--mk-cyan)]" aria-hidden="true"></span>Carga A · Lima → Arequipa</span><span class="mk-num text-white/85">1.8 t</span></li>
            <li class="flex items-center justify-between gap-3 rounded-input bg-white/5 px-3 py-2.5"><span class="flex items-center gap-2"><span class="size-2.5 rounded-sm bg-emerald-500" aria-hidden="true"></span>Carga B · Lima → Arequipa</span><span class="mk-num text-white/85">1.5 t</span></li>
          </ul>
          <div class="mt-5 flex h-3 overflow-hidden rounded-full bg-white/15" role="meter" aria-label="Ocupación del camión" aria-valuemin={0} aria-valuemax={5} aria-valuenow={3.3} aria-valuetext="3.3 de 5 toneladas">
            <span class="h-full bg-[var(--mk-cyan)]" style="width:36%"></span><span class="h-full bg-emerald-500" style="width:30%"></span>
          </div>
          <p class="mk-num mt-2 flex justify-between text-xs text-white/85"><span>3.3 / 5 t · Camión mediano</span><span>66 % lleno</span></p>
        </div>
      </div>

      <div class="mk-card mk-rv relative z-10 -mt-3 ml-auto w-[94%] rounded-card border border-steel-200 bg-surface p-5 shadow-xl sm:w-[88%] lg:-mt-4 lg:mr-0" style="--i:2">
        <div class="flex items-center justify-between gap-2"><p class="text-xs font-semibold uppercase tracking-[0.1em] text-ink-500">Carga de retorno</p><span class="rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-medium text-emerald-700">Compatible</span></div>
        <p class="mt-3 flex items-center gap-2 text-sm text-ink-700"><Truck size={16} class="text-petrol-700" aria-hidden="true" /> Entregas en <span class="font-semibold text-ink-900">Juliaca</span> el 30 nov. Sugerida para tu regreso:</p>
        <div class="mt-3 flex items-center justify-between gap-3 rounded-input border border-steel-200 bg-steel-100/70 px-3.5 py-3">
          <span><span class="block font-semibold text-ink-900">Juliaca → Lima</span><span class="mk-num block text-xs text-ink-500">{formatNumber(back, 1)} km · Recojo 1 dic · 2.4 t</span></span>
          <span class="rounded-input bg-emerald-700 px-3 py-1.5 text-[13px] font-medium text-on-solid" aria-hidden="true">Ofertar</span>
        </div>
      </div>
    </div>
  </div>
</section>
