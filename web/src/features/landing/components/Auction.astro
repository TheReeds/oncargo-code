---
import { FilePlus2, Gavel, Scale, Navigation } from '@lucide/astro';
import SectionHeading from './SectionHeading.astro';

const steps = [
  { icon: FilePlus2, t: 'Publica tu solicitud', d: 'Indica ruta, carga y fecha de recojo. Antes de publicar ves una cotización estimada con su desglose.' },
  { icon: Gavel, t: 'Los transportistas ofertan', d: 'La subasta dura hasta 20 minutos o cierra al llegar a 5 ofertas. Ninguna puede bajar del 75 % del precio sugerido.', note: 'Si pasan 24 horas sin ofertas, un operador de OnCargo asigna un transportista compatible.' },
  { icon: Scale, t: 'Aceptas la mejor oferta', d: 'Compara precio, vehículo y Trust Score. Al aceptar una, las demás se rechazan y nace tu envío.' },
  { icon: Navigation, t: 'Sigues el envío', d: 'Mira cada parada en el mapa, recibe avisos y cierra con la foto de evidencia de la entrega.' },
];
const quote = [
  ['Combustible', 'S/ 680.00'],
  ['Transporte', 'S/ 860.00'],
  ['Peajes', 'S/ 310.00'],
  ['Manipuleo', 'S/ 250.00'],
];
---
<section id="como-funciona" class="border-y border-steel-200 bg-surface" aria-labelledby="como-funciona-t">
  <div class="mx-auto w-full max-w-6xl px-4 py-14 lg:px-10 lg:py-20">
    <SectionHeading id="como-funciona-t" eyebrow="Cómo funciona" title="Una subasta inversa corta: los transportistas compiten, tú eliges" lead="De la solicitud a la entrega en cuatro pasos, con reglas claras para ambos lados." />
    <div class="mt-12 grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:gap-14">
      <ol class="relative space-y-8">
        <span class="absolute bottom-3 left-[21px] top-3 w-px bg-steel-200" aria-hidden="true"></span>
        {steps.map((s, i) => (
          <li class="relative flex gap-5">
            <span class="relative z-10 grid size-11 shrink-0 place-items-center rounded-input bg-petrol-700 text-on-solid ring-4 ring-surface"><s.icon size={20} aria-hidden="true" /></span>
            <div class="pt-0.5">
              <h3 class="flex items-baseline gap-2 text-lg font-semibold text-ink-900"><span class="font-mono text-sm text-ink-500" aria-hidden="true">0{i + 1}</span><span class="sr-only">Paso {i + 1}: </span>{s.t}</h3>
              <p class="mt-1 text-pretty text-sm text-ink-700">{s.d}</p>
              {s.note && <p class="mt-2 rounded-input bg-steel-100 px-3 py-2 text-xs text-ink-500">{s.note}</p>}
            </div>
          </li>
        ))}
      </ol>

      <figure class="self-start rounded-card border border-steel-200 bg-steel-100/60 p-5 lg:sticky lg:top-24 sm:p-6" aria-label="Ejemplo de cotización estimada">
        <div class="flex items-center justify-between gap-2">
          <p class="text-xs font-semibold uppercase tracking-wide text-ink-500">Cotización estimada</p>
          <span class="font-mono text-xs text-ink-500">Lima → Juliaca</span>
        </div>
        <dl class="mt-4 divide-y divide-steel-200 text-sm">
          {quote.map(([k, v]) => (
            <div class="flex items-center justify-between py-2.5"><dt class="text-ink-700">{k}</dt><dd class="font-mono tabular-nums text-ink-900">{v}</dd></div>
          ))}
          <div class="flex items-center justify-between py-3"><dt class="font-semibold text-ink-900">Precio sugerido</dt><dd class="money text-lg">S/ 2,100.00</dd></div>
          <div class="flex items-center justify-between py-2.5"><dt class="text-ink-700">Piso de la subasta <span class="text-ink-500">(75 %)</span></dt><dd class="font-mono tabular-nums text-ink-900">S/ 1,575.00</dd></div>
        </dl>
        <figcaption class="mt-3 text-xs text-ink-500">Ejemplo ilustrativo. El desglose real depende de la ruta, la carga y la fecha.</figcaption>
      </figure>
    </div>
  </div>
</section>
