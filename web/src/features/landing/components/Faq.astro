---
import { SUPPORT_EMAIL, notifyCityHref } from '@/lib/contact';
// Solo dudas que la landing no responde en otra sección. Respuestas de 1–2 frases (CONTENT.md, «Web pública»).
const faqs = [
  { q: '¿Cuánto dura la subasta y qué pasa al terminar?', a: 'Hasta 20 minutos, o se cierra al llegar a 5 ofertas. Aceptas una y las demás se rechazan.' },
  { q: '¿Cómo se calcula el precio sugerido?', a: 'Con los km por carretera, el peso y el tipo de carga: combustible, transporte, peajes y manipuleo. Ninguna oferta baja del 75 % de ese precio.' },
  { q: '¿Cuánto cuesta y quién paga la comisión?', a: 'Publicar y comparar ofertas es gratis para tu empresa. La comisión la paga el transportista; la tasa está en Precios. El precio que aceptas incluye IGV.', href: '/precios' },
  { q: '¿Cómo se paga el flete?', a: 'Directamente al transportista, contra su factura. OnCargo todavía no procesa pagos.' },
  { q: '¿Quién responde si se daña o se pierde la carga?', a: 'El transportista, según su póliza de seguro. Tú declaras el peso, la naturaleza y el valor de la carga al publicar. Detalle en los términos (borrador).', href: '/terminos#responsabilidad' },
  { q: '¿Cuánto demora la verificación de mi empresa?', a: 'Normalmente un día hábil. Te avisamos cuando puedas publicar u ofertar.' },
  { q: '¿Qué ciudades cubren?', a: 'Lima, Ica, Nazca, Arequipa, Moquegua, Tacna, Juliaca, Puno, Cusco, Abancay y Ayacucho.', link: true },
];
---
<section id="preguntas" class="border-t border-steel-200 bg-surface" aria-labelledby="preguntas-t">
  <div class="mx-auto grid w-full max-w-[1280px] gap-8 px-4 py-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-14 lg:px-10 lg:py-16">
    <div class="lg:sticky lg:top-24 lg:self-start">
      <div class="mk-rv">
        <p class="mk-eyebrow">Preguntas frecuentes</p>
        <h2 id="preguntas-t" class="mk-h2 mt-3 text-ink-900">Antes de <span class="text-petrol-700">publicar tu carga</span></h2>
      </div>
      <p class="mk-rv mt-5 text-sm text-ink-700" style="--i:1">¿Otra duda? Escribe a <a href={`mailto:${SUPPORT_EMAIL}`} class="font-medium text-petrol-700 underline underline-offset-2">{SUPPORT_EMAIL}</a> o mira <a href="/contacto" class="font-medium text-petrol-700 underline underline-offset-2">Contacto</a>.</p>
    </div>
    <div class="faq mk-rv-fade divide-y divide-steel-200 border-y border-steel-200">
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}{f.href && <> <a href={f.href} class="font-medium text-petrol-700 underline underline-offset-2">{f.href === '/precios' ? 'Ver precios' : 'Leer los términos'}</a>.</>}{f.link && <> <a href={notifyCityHref()} class="font-medium text-petrol-700 underline underline-offset-2">Avísame cuando lleguen a mi ciudad</a>.</>}</p>
        </details>
      ))}
    </div>
  </div>
</section>
