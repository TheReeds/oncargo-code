---
import { Building2, Truck, ArrowRight, ShieldCheck, Timer, BadgeCheck } from '@lucide/astro';
import BgVideo from '@/components/media/BgVideo.astro';
const pts = [
  { icon: BadgeCheck, t: 'Valida tu RUC al registrarte' },
  { icon: Timer, t: 'Subastas de 20 min o 5 ofertas' },
  { icon: ShieldCheck, t: 'Empresas verificadas y datos protegidos' },
];
---
<section class="mk-dark relative isolate overflow-hidden" aria-labelledby="cta-t">
  <BgVideo desktop="cierre-cabina" poster="cierre-cabina" width={1280} height={720} control label="vídeo de la cabina" class="bgv--flat" controlClass="right-4 top-4" />
  <div class="mx-auto w-full max-w-[1280px] px-4 py-14 lg:px-10 lg:py-20">
    <div class="grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-end lg:gap-12">
      <div class="mk-rv">
        <p class="mk-eyebrow">Empieza hoy</p>
        <h2 id="cta-t" class="mk-display mt-3 text-[clamp(2rem,1.2rem+3.4vw,4rem)]">Tu próximo flete, <span class="text-emerald-500">con precio claro</span></h2>
        <p class="mk-lead mt-4 text-base text-white/90 lg:text-lg">Crea tu cuenta, valida tu RUC y arma tu primera solicitud o tu flota en minutos.</p>
      </div>
      <ul class="mk-rv flex flex-col gap-2.5 text-sm text-white/90" style="--i:1">
        {pts.map((p) => <li class="flex items-center gap-2.5"><p.icon size={18} class="shrink-0 text-emerald-500" aria-hidden="true" />{p.t}</li>)}
      </ul>
    </div>
    <div class="mt-8 grid gap-4 md:grid-cols-2 lg:mt-10">
      <a href="/registro" class="mk-rv-l group flex items-center gap-4 rounded-card border border-white/25 bg-chrome/60 p-5 backdrop-blur-sm transition-colors hover:border-white/50 hover:bg-chrome/80 sm:p-6">
        <span class="grid size-12 shrink-0 place-items-center rounded-input bg-white text-chrome"><Building2 size={24} aria-hidden="true" /></span>
        <span class="min-w-0 flex-1"><span class="block text-lg font-semibold">Tengo carga que enviar</span><span class="mt-0.5 block text-sm text-white/85">Crea la cuenta de tu empresa y publica tu primera solicitud.</span></span>
        <ArrowRight size={20} class="shrink-0 transition-transform group-hover:translate-x-1" aria-hidden="true" /><span class="sr-only">Crear cuenta de empresa</span>
      </a>
      <a href="/registro?tipo=transportista" class="mk-rv-r group flex items-center gap-4 rounded-card border border-white/25 bg-chrome/60 p-5 backdrop-blur-sm transition-colors hover:border-white/50 hover:bg-chrome/80 sm:p-6">
        <span class="grid size-12 shrink-0 place-items-center rounded-input bg-emerald-500 text-chrome"><Truck size={24} aria-hidden="true" /></span>
        <span class="min-w-0 flex-1"><span class="block text-lg font-semibold">Soy transportista</span><span class="mt-0.5 block text-sm text-white/85">Registra tu flota y oferta por las cargas compatibles.</span></span>
        <ArrowRight size={20} class="shrink-0 transition-transform group-hover:translate-x-1" aria-hidden="true" /><span class="sr-only">Registrarme para ofertar</span>
      </a>
    </div>
  </div>
</section>
