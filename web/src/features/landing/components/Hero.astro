---
import { ArrowRight, ShieldCheck, Truck, Building2 } from '@lucide/astro';
import BgVideo from '@/components/media/BgVideo.astro';
import AuctionLive from './AuctionLive.astro';

const kpis = [
  { n: 20, u: 'min', t: 'duración máxima de la subasta' },
  { n: 5, u: 'ofertas', t: 'tope por solicitud; cierra al completarse' },
  { n: 75, u: '%', t: 'del sugerido es el piso de cada oferta' },
  { n: 11, u: 'ciudades', t: 'entre Lima y la sierra sur' },
];
const cta = 'inline-flex h-12 whitespace-nowrap items-center justify-center gap-2 rounded-input px-6 text-[15px] font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white';
---
<section class="relative isolate flex min-h-[calc(100svh-4rem)] flex-col overflow-hidden mk-dark text-white" aria-labelledby="hero-title">
  <BgVideo desktop="hero-corredor" mobile="hero-corredor-movil" poster="hero-corredor" posterMobile="hero-corredor-movil" width={1920} height={1080} priority control class="bgv--hero bgv--hero-lead" label="vídeo de fondo del corredor" controlClass="right-4 top-4" />
  <div class="mk-grid absolute inset-0 -z-[5] opacity-60" aria-hidden="true"></div>

  <div class="mx-auto grid w-full max-w-[1280px] flex-1 items-center gap-10 px-4 pb-8 pt-8 lg:grid-cols-[minmax(0,1.02fr)_minmax(0,0.98fr)] lg:gap-12 lg:px-10 lg:pb-6 lg:pt-6">
    <div>
      <p class="mk-in inline-flex items-center gap-2 rounded-full border border-white/25 bg-chrome/60 px-3 py-1 text-xs font-medium text-white backdrop-blur" style="--d:0ms">
        <span class="relative size-1.5 rounded-full bg-emerald-500 text-emerald-500 mk-ping" aria-hidden="true"></span> Corredor Lima – Arequipa – Cusco – Puno
      </p>
      <h1 id="hero-title" class="mk-display mk-in mt-5 text-[clamp(2.5rem,1.4rem+4.6vw,5rem)]" style="--d:80ms">Contrata fletes. <span class="text-emerald-500">Sin llamadas.</span></h1>
      <p class="mk-in mt-5 max-w-[34rem] text-pretty text-lg text-white/90 lg:text-xl" style="--d:160ms">Publica tu carga, recibe ofertas de transportistas verificados en una subasta de 20 minutos y sigue tu envío parada por parada.</p>
      <div class="mk-in mt-8 grid gap-3 sm:grid-cols-2 sm:max-w-[34rem]" style="--d:240ms">
        <a href="/registro" class:list={[cta, 'bg-white text-chrome hover:bg-white/90']}><Building2 size={18} class="shrink-0" aria-hidden="true" /> Crear cuenta de empresa <ArrowRight size={16} class="shrink-0" aria-hidden="true" /></a>
        <a href="/registro?tipo=transportista" class:list={[cta, 'border border-white/40 bg-chrome/55 text-white backdrop-blur hover:bg-chrome/80']}><Truck size={18} class="shrink-0" aria-hidden="true" /> Soy transportista</a>
      </div>
      <p class="mk-in mt-4 text-sm text-white/85" style="--d:300ms">¿Ya tienes cuenta? <a href="/login" class="font-semibold text-white underline underline-offset-2 hover:text-white/80">Ingresa</a></p>
      <p class="mk-in mt-6 inline-flex items-center gap-2 text-sm text-white/90" style="--d:360ms"><ShieldCheck size={16} class="text-emerald-500" aria-hidden="true" /> Empresas verificadas por OnCargo · Datos protegidos (Ley 29733)</p>
    </div>

    <div class="mk-in lg:pl-2" style="--d:220ms"><AuctionLive /></div>
  </div>

  <ul class="relative mx-auto grid w-full max-w-[1280px] grid-cols-2 border-t border-white/15 bg-chrome/55 backdrop-blur-sm lg:grid-cols-4 lg:px-10" aria-label="La subasta en cifras">
    {kpis.map((f, i) => (
      <li class:list={['px-4 py-3.5 lg:py-4', i % 2 === 1 && 'border-l border-white/15', i >= 2 && 'border-t border-white/15 lg:border-t-0', i >= 1 && 'lg:border-l lg:border-white/15', 'lg:px-6 first:lg:pl-0']}>
        <p class="mk-num text-3xl font-semibold tracking-tight sm:text-[36px] sm:leading-none"><span data-count={f.n}>{f.n}</span><span class="ml-1.5 text-base font-medium text-white/80">{f.u}</span></p>
        <p class="mt-1.5 max-w-[26ch] text-pretty text-[13px] leading-snug text-white/80">{f.t}</p>
      </li>
    ))}
  </ul>
</section>
