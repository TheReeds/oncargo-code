---
import Base from './Base.astro';
import Logo from '@/components/layout/Logo.astro';
interface Props { title: string }
---
<Base title={Astro.props.title}>
  <div class="flex min-h-screen flex-col">
    <header class="flex h-16 items-center justify-between px-4 lg:px-10">
      <a href="/" aria-label="LOGYX inicio"><Logo /></a>
      <nav class="flex items-center gap-2 text-sm">
        <a href="/login" class="rounded-input px-3 py-2 font-medium text-ink-700 hover:bg-white">Ingresar</a>
        <a href="/registro" class="rounded-input bg-petrol-700 px-4 py-2 font-medium text-white hover:bg-petrol-800">Crear cuenta</a>
      </nav>
    </header>
    <main class="flex-1"><slot /></main>
    <footer class="px-4 py-6 text-center text-xs text-ink-500 lg:px-10">
      © 2026 LOGYX · <a class="underline" href="/privacidad">Política de privacidad</a>
    </footer>
  </div>
</Base>
