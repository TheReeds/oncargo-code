---
import '@/styles/global.css';
import Overlays from '@/components/ui/toaster';
interface Props { title: string; description?: string; /** Imagen para redes (1200×630). */ ogImage?: string }
const { title, description = 'OnCargo: marketplace de fletes para PYMEs del corredor Lima – Sierra Sur. Publica tu carga, recibe ofertas y sigue tu envío.', ogImage = '/brand/og-oncargo.png' } = Astro.props;
const fullTitle = `${title} · OnCargo`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const og = new URL(ogImage, Astro.url).href;
---
<!doctype html>
<html lang="es-PE" data-perms={Astro.locals.session?.permissions.join(' ')} data-role={Astro.locals.session?.role ?? undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0e1726" />
    <meta name="application-name" content="OnCargo" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content="OnCargo" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="OnCargo, fletes entre Lima y la sierra sur" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <meta name="color-scheme" content="light dark" />
    <!-- Anti-parpadeo: fija data-theme antes del primer pintado (lógica espejo de src/lib/theme.ts). -->
    <script is:inline>
      (function () {
        var p = 'system';
        try { var v = localStorage.getItem('logyx-theme'); if (v === 'light' || v === 'dark' || v === 'system') p = v; } catch (e) {}
        var t = p === 'system' ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light') : p;
        document.documentElement.dataset.theme = t;
        document.documentElement.style.colorScheme = t;
      })();
    </script>
    <title>{fullTitle}</title>
  </head>
  <body>
    <slot />
    <Overlays client:load />
  </body>
</html>
