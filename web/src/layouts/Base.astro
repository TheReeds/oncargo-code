---
import '@/styles/global.css';
import Overlays from '@/components/ui/toaster';
import { SITE_URL, INDEXABLE_PATHS } from '@/features/landing/seo';
interface Props {
  /** Título de la página; el `<title>` queda `<title> · OnCargo` (≤ 60 caracteres en total en las páginas públicas). */
  title: string;
  /** Meta description única por página (120–160 caracteres). */
  description?: string;
  /** Imagen para redes (1200×630). */
  ogImage?: string;
  /** Páginas con un secreto en la URL (seguimiento público `/s/<token>`): sin indexar, sin `Referer`, sin canónica ni vista previa social. */
  privateUrl?: boolean;
  /** Datos estructurados JSON-LD (uno o varios nodos; se publican en un `@graph`). Solo en páginas indexables. */
  jsonLd?: Record<string, unknown>[];
  /** Hidratación de toasts y confirmaciones: `load` (paneles) o `idle` (páginas públicas: fuera del camino del LCP). */
  overlays?: 'load' | 'idle';
}
const { title, description = 'OnCargo: fletes para PYMEs entre Lima, Arequipa, Cusco, Juliaca y Puno. Publica tu carga y recibe hasta 5 ofertas de transportistas verificados en 20 minutos.', ogImage = '/brand/og-oncargo.png', privateUrl = false, jsonLd, overlays = 'load' } = Astro.props;
const fullTitle = `${title} · OnCargo`;
// Solo las páginas públicas de INDEXABLE_PATHS (la misma lista que public/sitemap.xml) llevan canónica y se indexan;
// el resto (paneles, login, recuperación de contraseña, /dev, /s/<token>) va con noindex.
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const indexable = !privateUrl && INDEXABLE_PATHS.includes(path);
const canonical = indexable ? new URL(path, SITE_URL).href : undefined;
const og = new URL(ogImage, SITE_URL).href;
const ld = indexable && jsonLd?.length ? JSON.stringify({ '@context': 'https://schema.org', '@graph': jsonLd }).replace(/</g, '\\u003c') : undefined;
---
<!doctype html>
<html lang="es-PE" data-perms={Astro.locals.session?.permissions.join(' ')} data-role={Astro.locals.session?.role ?? undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0e1726" />
    <meta name="application-name" content="OnCargo" />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <link rel="alternate" hreflang="es-PE" href={canonical} />}
    {privateUrl ? <meta name="robots" content="noindex, nofollow, noarchive" /> : !indexable && <meta name="robots" content="noindex" />}
    {privateUrl && <meta name="referrer" content="no-referrer" />}
    <meta property="og:site_name" content="OnCargo" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="OnCargo, fletes entre Lima y la sierra sur" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <meta name="color-scheme" content="light dark" />
    <!-- Anti-parpadeo: fija data-theme antes del primer pintado (lógica espejo de src/lib/theme.ts). -->
    <script is:inline>
      (function () {
        var p = 'system';
        try { var v = localStorage.getItem('logyx-theme'); if (v === 'light' || v === 'dark' || v === 'system') p = v; } catch (e) {}
        var t = p === 'system' ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light') : p;
        document.documentElement.dataset.theme = t;
        document.documentElement.style.colorScheme = t;
      })();
    </script>
    <title>{fullTitle}</title>
    {ld && <script type="application/ld+json" set:html={ld} />}
  </head>
  <body>
    <slot />
    {overlays === 'idle' ? <Overlays client:idle /> : <Overlays client:load />}
  </body>
</html>
