---
import AppShell from '@/components/layout/AppShell.astro';
import { Card, CardBody, CardHeader, CardTitle } from '@/components/ui/card';
import { Avatar } from '@/components/ui/avatar';
import { Badge } from '@/components/ui/badge';
import { StarRating } from '@/components/ui/star-rating';
import { VerifiedBadge } from '@/components/domain/VerifiedBadge';
import { TrustScore } from '@/components/domain/TrustScore';
import { EmptyState } from '@/components/domain/EmptyState';
import { buttonVariants } from '@/components/ui/button';
import { ReviewCard } from '@/features/reputation/components/ReviewCard';
import OrgReviewsPager from '@/features/reputation/components/OrgReviewsPager';
import { getReputation, listOrgReviews } from '@/features/reputation/server';
import { ApiError } from '@/lib/api/client';
import { CITY_LABELS } from '@/lib/format';

const { id } = Astro.params;
const token = Astro.locals.session!.token;
const page = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);
const SIZE = 10;
let rep, reviews;
let notFound = false;
try {
  rep = await getReputation(token, id!);
  reviews = await listOrgReviews(token, id!, page - 1, SIZE);
} catch (e) {
  if (e instanceof ApiError && [400, 403, 404].includes(e.status)) notFound = true;
  else throw e;
}
if (notFound) Astro.response.status = 404;
const home = Astro.locals.session!.orgType === 'CARRIER' ? '/transportista/marketplace' : Astro.locals.session!.orgType === 'OPERATOR' ? '/operador' : '/pyme';
const isCarrier = rep?.type === 'CARRIER';
const typeLabel = isCarrier ? 'Transportista' : 'PYME';
const cargoDim = isCarrier ? 'Estado de la carga' : 'Exactitud de la carga declarada';
const dims = rep ? [['Puntualidad', rep.averagePunctuality], [cargoDim, rep.averageCargoCondition], ['Comunicación', rep.averageCommunication]] as const : [];
const hasReviews = (rep?.totalReviews ?? 0) > 0;
const cityLabel = rep ? (CITY_LABELS[(rep.city ?? '').toUpperCase()] ?? rep.city) : '';
---
<AppShell title={rep ? `${rep.legalName} · Reputación` : 'Organización no encontrada'} active="">
  <nav aria-label="Ruta de navegación" class="mb-4 text-sm text-ink-500">
    <ol class="flex flex-wrap items-center gap-1.5">
      <li><a href={home} class="rounded hover:text-petrol-700 hover:underline">Inicio</a></li>
      <li aria-hidden="true">/</li>
      <li>Organizaciones</li>
      <li aria-hidden="true">/</li>
      <li aria-current="page" class="font-medium text-ink-700">{rep?.legalName ?? 'No encontrada'}</li>
    </ol>
  </nav>

  {!rep && (
    <Card>
      <EmptyState title="No encontramos esta organización" description="El enlace puede estar incompleto o la organización ya no existe." />
      <div class="flex justify-center pb-8"><a href={home} class={buttonVariants({ variant: 'outline' })}>Volver al inicio</a></div>
    </Card>
  )}

  {rep && (
    <div class="space-y-6">
      <Card>
        <CardBody className="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
          <div class="flex min-w-0 items-center gap-4">
            <Avatar name={rep.legalName ?? '?'} size="lg" className="size-16 text-xl" />
            <div class="min-w-0">
              <h1 class="text-[26px] font-semibold leading-tight tracking-tight text-ink-900 sm:text-3xl">{rep.legalName}</h1>
              <div class="mt-2 flex flex-wrap items-center gap-2 text-sm text-ink-500">
                <Badge tone="petrol">{typeLabel}</Badge>
                {cityLabel && <span>{cityLabel}</span>}
                <VerifiedBadge verified={rep.rucVerified} />
              </div>
            </div>
          </div>
          <div class="w-full lg:w-72">
            <div class="flex items-baseline justify-between"><span class="text-xs font-medium text-ink-500">Trust Score</span><span class="font-mono text-3xl font-semibold tabular-nums text-ink-900">{rep.trustScore?.toFixed(1)}<span class="text-base text-ink-500">/100</span></span></div>
            <TrustScore variant="meter" score={rep.trustScore} reviews={rep.totalReviews} className="mt-1 [&>div:first-child]:hidden" />
          </div>
        </CardBody>
      </Card>

      <div class="grid gap-6 lg:grid-cols-3">
        <div class="space-y-6 lg:col-span-1">
          <Card>
            <CardHeader><CardTitle>Promedio por dimensión</CardTitle></CardHeader>
            <CardBody className="space-y-4">
              <div class="flex items-center gap-3">
                <span class="font-mono text-3xl font-semibold tabular-nums text-ink-900">{hasReviews ? rep.averageRating?.toFixed(1) : '—'}</span>
                <div>
                  <StarRating readOnly value={hasReviews ? rep.averageRating : null} label="Calificación promedio" size="md" />
                  <p class="text-xs text-ink-500">{rep.totalReviews} {rep.totalReviews === 1 ? 'reseña' : 'reseñas'}</p>
                </div>
              </div>
              <ul class="space-y-3">
                {dims.map(([label, v]) => (
                  <li>
                    <div class="flex items-center justify-between text-sm"><span class="text-ink-700">{label}</span><span class="font-mono tabular-nums text-ink-900">{hasReviews && v != null ? v.toFixed(1) : '—'}</span></div>
                    <div class="mt-1 h-1.5 overflow-hidden rounded-full bg-steel-200" role="presentation"><div class="h-full rounded-full bg-amber-500" style={`width:${hasReviews && v != null ? Math.round((v / 5) * 100) : 0}%`}></div></div>
                  </li>
                ))}
              </ul>
            </CardBody>
          </Card>
          <Card>
            <CardHeader><CardTitle>Cómo se calcula el Trust Score</CardTitle></CardHeader>
            <CardBody className="space-y-2 text-sm text-ink-700">
              <p>Sin calificaciones, toda organización parte en <strong class="font-mono">{rep.priorMean ?? 75}</strong> puntos.</p>
              <p>Cada calificación (1 a 5) se convierte a una escala de 0 a 100 y se promedia con {rep.priorWeight ?? 5} calificaciones de referencia de {rep.priorMean ?? 75} puntos. Así, una sola nota no dispara ni hunde el puntaje, y pesa más a medida que se acumulan las reseñas.</p>
              <p class="rounded-input bg-steel-100 px-3 py-2 font-mono text-xs text-ink-700">puntaje = ({rep.priorWeight ?? 5} × {rep.priorMean ?? 75} + Σ notas) / ({rep.priorWeight ?? 5} + n)</p>
            </CardBody>
          </Card>
        </div>

        <section class="lg:col-span-2" aria-labelledby="resenas">
          <h2 id="resenas" class="mb-3 text-xl font-semibold text-ink-900">Reseñas recibidas</h2>
          {reviews && reviews.items.length > 0 ? (
            <div class="space-y-4">
              <ul class="space-y-3">{reviews.items.map((r) => <ReviewCard review={r} />)}</ul>
              <OrgReviewsPager client:load page={page} size={reviews.size} total={reviews.total} />
            </div>
          ) : (
            <Card><EmptyState title="Aún no tiene reseñas" description="Cuando otras organizaciones califiquen sus envíos, las verás aquí. Mientras tanto, su Trust Score se mantiene en 75." /></Card>
          )}
        </section>
      </div>
    </div>
  )}
</AppShell>
