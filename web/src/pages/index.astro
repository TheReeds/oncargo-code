---
import Public from '@/layouts/Public.astro';
import { buttonVariants } from '@/components/ui/button';
import { Badge } from '@/components/ui/badge';
import { RouteLine } from '@/components/domain/RouteLine';
import { TruckIllustration } from '@/components/domain/EmptyState';
import { Gavel, MapPinned, ShieldCheck, FilePlus2, Scale, Navigation, ArrowRight, Building2, Truck } from '@lucide/astro';

const steps = [
  { icon: FilePlus2, t: 'Publica tu solicitud', d: 'Indica ruta, carga y fecha de recojo. Te mostramos una cotización estimada al instante.' },
  { icon: Scale, t: 'Compara ofertas', d: 'Hasta 5 transportistas ofertan durante la subasta. Elige por precio, vehículo y verificación.' },
  { icon: Navigation, t: 'Sigue tu envío', d: 'Acepta una oferta y mira en el mapa cada parada, del recojo a la entrega.' },
];
const points = [
  { icon: Gavel, t: 'Subasta inversa', d: 'Los transportistas compiten por tu carga y el precio baja a tu favor.' },
  { icon: ShieldCheck, t: 'Empresas verificadas', d: 'Cada transportista valida su RUC antes de poder ofertar.' },
  { icon: MapPinned, t: 'Seguimiento por paradas', d: 'Estado y ubicación de tu carga en cada tramo, sin llamadas.' },
];
---
<Public title="Fletes entre Lima y la sierra sur" description="Publica tu carga, recibe ofertas de transportistas verificados y sigue tu envío parada por parada.">
  <section class="mx-auto grid w-full max-w-6xl items-center gap-10 px-4 py-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-14 lg:px-10 lg:py-20">
    <div>
      <p class="mb-4 inline-flex items-center gap-2 rounded-full bg-petrol-50 px-3 py-1 text-xs font-medium text-petrol-700">
        <span class="size-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span> Corredor Lima – Arequipa – Cusco – Puno
      </p>
      <h1 class="text-[34px] font-semibold leading-[1.1] tracking-tight text-ink-900 sm:text-5xl">Contrata fletes al mejor precio, sin llamadas.</h1>
      <p class="mt-5 max-w-xl text-lg text-ink-700">Publica tu carga, recibe ofertas de transportistas verificados y sigue tu envío parada por parada.</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/registro" class={buttonVariants({ size: 'lg' }) + ' sm:px-8'}>Crear cuenta <ArrowRight size={16} aria-hidden="true" /></a>
        <a href="/login" class={buttonVariants({ variant: 'outline', size: 'lg' }) + ' sm:px-8'}>Ingresar</a>
      </div>
      <p class="mt-4 text-sm text-ink-500">¿Eres transportista? <a href="/registro?tipo=transportista" class="font-medium text-petrol-700 underline underline-offset-2">Regístrate para ofertar</a></p>
    </div>

    <figure class="relative" aria-label="Ejemplo de solicitud con ofertas">
      <div class="rounded-card border border-steel-200 bg-surface p-5 shadow-sm sm:p-6">
        <div class="mb-4 flex items-center justify-between">
          <span class="text-xs font-semibold uppercase tracking-wide text-ink-500">Ejemplo de solicitud</span>
          <Badge tone="petrol">Publicada</Badge>
        </div>
        <RouteLine origin="LIMA" destination="JULIACA" km={1010} originSub="28 nov · 08:00" destinationSub="30 nov" />
        <div class="mt-5 flex justify-center rounded-input bg-steel-100 py-6"><TruckIllustration /></div>
        <ul class="mt-5 divide-y divide-steel-200 text-sm">
          <li class="flex items-center justify-between py-2.5"><span class="text-ink-700">Transportista A</span><span class="font-mono tabular-nums text-ink-900">S/ 1,990.00</span></li>
          <li class="flex items-center justify-between py-2.5"><span class="text-ink-700">Transportista B</span><span class="font-mono tabular-nums text-ink-900">S/ 1,920.00</span></li>
          <li class="flex items-center justify-between rounded-input bg-emerald-50 px-2 py-2.5 -mx-2">
            <span class="font-medium text-emerald-700">Mejor oferta</span>
            <span class="money font-mono text-lg font-semibold tabular-nums text-emerald-700">S/ 1,850.00</span>
          </li>
        </ul>
      </div>
    </figure>
  </section>

  <section class="border-y border-steel-200 bg-surface" aria-labelledby="como-funciona">
    <div class="mx-auto w-full max-w-6xl px-4 py-14 lg:px-10 lg:py-16">
      <h2 id="como-funciona" class="text-2xl font-semibold tracking-tight text-ink-900 sm:text-3xl">Cómo funciona</h2>
      <p class="mt-2 max-w-xl text-ink-500">De la solicitud a la entrega en tres pasos.</p>
      <ol class="mt-10 grid gap-5 md:grid-cols-3">
        {steps.map((s, i) => (
          <li class="relative rounded-card border border-steel-200 bg-steel-100/50 p-6">
            <div class="flex items-center justify-between">
              <span class="grid size-11 place-items-center rounded-input bg-petrol-700 text-white"><s.icon size={22} aria-hidden="true" /></span>
              <span class="font-mono text-3xl font-semibold text-steel-200" aria-hidden="true">0{i + 1}</span>
            </div>
            <h3 class="mt-5 text-lg font-semibold text-ink-900"><span class="sr-only">Paso {i + 1}: </span>{s.t}</h3>
            <p class="mt-1.5 text-sm text-ink-700">{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-4 py-14 lg:px-10 lg:py-16" aria-labelledby="ventajas">
    <h2 id="ventajas" class="sr-only">Ventajas</h2>
    <div class="grid gap-6 sm:grid-cols-3">
      {points.map((p) => (
        <div class="flex gap-4">
          <span class="grid size-10 shrink-0 place-items-center rounded-full bg-emerald-50 text-emerald-700"><p.icon size={20} aria-hidden="true" /></span>
          <div>
            <h3 class="font-semibold text-ink-900">{p.t}</h3>
            <p class="mt-1 text-sm text-ink-500">{p.d}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-4 pb-16 lg:px-10" aria-labelledby="cta">
    <div class="overflow-hidden rounded-card bg-ink-900 px-6 py-10 text-white sm:px-10 sm:py-12">
      <h2 id="cta" class="max-w-xl text-2xl font-semibold tracking-tight sm:text-3xl">Empieza hoy, según cómo trabajes</h2>
      <div class="mt-7 grid gap-4 md:grid-cols-2">
        <a href="/registro" class="group rounded-card border border-white/15 bg-white/5 p-5 transition-colors hover:bg-white/10">
          <Building2 size={22} class="text-emerald-500" aria-hidden="true" />
          <h3 class="mt-3 font-semibold">Tengo carga que enviar</h3>
          <p class="mt-1 text-sm text-white/70">Crea la cuenta de tu empresa y publica tu primera solicitud.</p>
          <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium">Crear cuenta de empresa <ArrowRight size={16} class="transition-transform group-hover:translate-x-0.5" aria-hidden="true" /></span>
        </a>
        <a href="/registro?tipo=transportista" class="group rounded-card border border-white/15 bg-white/5 p-5 transition-colors hover:bg-white/10">
          <Truck size={22} class="text-emerald-500" aria-hidden="true" />
          <h3 class="mt-3 font-semibold">Soy transportista</h3>
          <p class="mt-1 text-sm text-white/70">Registra tu flota y oferta por las cargas compatibles.</p>
          <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium">Registrarme para ofertar <ArrowRight size={16} class="transition-transform group-hover:translate-x-0.5" aria-hidden="true" /></span>
        </a>
      </div>
    </div>
  </section>
</Public>
