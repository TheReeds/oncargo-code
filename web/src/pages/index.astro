---
import Public from '@/layouts/Public.astro';
import { Gavel, MapPinned, ShieldCheck } from '@lucide/astro';
import { TruckIllustration } from '@/components/domain/EmptyState';
const points = [
  { icon: Gavel, t: 'Subasta inversa', d: 'Hasta 5 transportistas compiten por tu carga. Tú eliges la mejor oferta.' },
  { icon: ShieldCheck, t: 'Empresas verificadas', d: 'Cada transportista valida su RUC antes de ofertar.' },
  { icon: MapPinned, t: 'Seguimiento por paradas', d: 'Mira en el mapa dónde está tu carga, de recojo a entrega.' },
];
---
<Public title="Fletes Lima–Sierra Sur">
  <section class="mx-auto grid w-full max-w-6xl items-center gap-10 px-4 py-12 lg:grid-cols-2 lg:px-10 lg:py-20">
    <div>
      <p class="mb-3 inline-flex rounded-full bg-petrol-50 px-3 py-1 text-xs font-medium text-petrol-700">Corredor Lima – Arequipa – Cusco – Puno</p>
      <h1 class="text-4xl font-semibold leading-tight tracking-tight text-ink-900 lg:text-5xl">Contrata fletes al mejor precio, sin llamadas.</h1>
      <p class="mt-4 max-w-lg text-lg text-ink-700">Publica tu carga, recibe ofertas de transportistas verificados y sigue tu envío parada por parada.</p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href="/login" class="inline-flex h-11 items-center rounded-input bg-petrol-700 px-6 font-medium text-white hover:bg-petrol-800">Ingresar</a>
        <a href="/registro" class="inline-flex h-11 items-center rounded-input border border-steel-200 bg-surface px-6 font-medium hover:bg-steel-100">Crear cuenta</a>
      </div>
      <p class="mt-3 text-sm text-ink-500">¿Eres transportista? <a href="/registro?tipo=transportista" class="font-medium text-petrol-700 underline">Regístrate para ofertar</a></p>
    </div>
    <div class="rounded-card border border-steel-200 bg-surface p-6">
      <div class="mb-4 flex items-center justify-between text-sm"><span class="font-semibold">Lima → Juliaca</span><span class="font-mono text-xs text-ink-500">1,010 km</span></div>
      <div class="flex justify-center rounded-input bg-steel-100 py-6"><TruckIllustration /></div>
      <div class="mt-4 flex items-end justify-between"><div><div class="text-xs text-ink-500">Mejor oferta</div><div class="font-mono text-2xl font-semibold text-emerald-700">S/ 1,850.00</div></div><span class="rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-medium text-emerald-700">-6% vs sugerido</span></div>
    </div>
  </section>
  <section class="mx-auto grid w-full max-w-6xl gap-4 px-4 pb-16 sm:grid-cols-3 lg:px-10">
    {points.map((p) => (
      <div class="rounded-card border border-steel-200 bg-surface p-5">
        <p.icon size={22} class="text-petrol-700" />
        <h2 class="mt-3 font-semibold">{p.t}</h2>
        <p class="mt-1 text-sm text-ink-500">{p.d}</p>
      </div>
    ))}
  </section>
</Public>
