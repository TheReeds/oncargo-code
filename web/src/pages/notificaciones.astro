---
import AppShell from '@/components/layout/AppShell.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import NotificationsList from '@/features/notifications/components/NotificationsList';
import { Settings2 } from '@lucide/astro';
const orgType = Astro.locals.session!.orgType;
---
<AppShell title="Notificaciones" active="">
  <PageHeader title="Notificaciones" subtitle="Tus avisos de ofertas, mensajes, envíos e incidencias. Lo que marcas como leído no cambia para tus compañeros.">
    <a slot="actions" href="/cuenta/avisos" class="inline-flex items-center gap-1.5 rounded-input border border-steel-200 px-3 py-1.5 text-sm font-medium text-ink-700 hover:bg-steel-100"><Settings2 size={16} aria-hidden="true" /> Elegir qué avisos recibo</a>
  </PageHeader>
  <NotificationsList client:load orgType={orgType} />
</AppShell>
