---
import Base from '@/layouts/Base.astro';
import Logo from '@/components/layout/Logo.astro';
import ThemeToggle from '@/components/ui/theme-toggle';
import PublicTracking from '@/features/shipments/components/PublicTracking';
import { publicTracking } from '@/features/shipments/server';

export const prerender = false;
// Seguimiento público (roadmap 1.6, ADR-0011): sin sesión, sin indexar, sin Referer (el token va en la URL) y sin caché.
const token = Astro.params.token ?? '';
let clientIp: string | undefined;
try { clientIp = Astro.clientAddress; } catch { clientIp = undefined; }
const { data, status } = await publicTracking(token, clientIp);
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
if (!data) Astro.response.status = status === 429 ? 429 : status === 502 ? 503 : 404;
const title = data ? `Seguimiento del envío ${data.code ?? ''}`.trim() : 'Seguimiento de envío';
---
<Base title={title} description="Sigue tu envío con OnCargo: estado, hitos y llegada estimada." privateUrl>
  <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-[60] focus:rounded-input focus:bg-surface focus:text-ink-900 focus:px-3 focus:py-2">Saltar al contenido</a>
  <div class="flex min-h-screen flex-col bg-steel-100">
    <header class="border-b border-steel-200/70 bg-steel-100/90">
      <div class="mx-auto flex h-16 w-full max-w-3xl items-center justify-between gap-4 px-4">
        <a href="/" aria-label="OnCargo, inicio" class="shrink-0 rounded-input"><Logo /></a>
        <ThemeToggle client:load />
      </div>
    </header>
    <main id="contenido" class="mx-auto w-full max-w-3xl flex-1 space-y-4 px-4 py-6">
      <h1 class="text-2xl font-semibold text-ink-900">Seguimiento de tu envío</h1>
      {data ? (
        <PublicTracking client:load token={token} initial={data} />
      ) : status === 429 ? (
        <div role="status" class="rounded-card border border-steel-200 bg-surface p-5 text-sm text-ink-700">
          <p class="font-medium text-ink-900">Demasiadas consultas seguidas</p>
          <p class="mt-1">Espera unos minutos y vuelve a abrir el enlace.</p>
        </div>
      ) : status === 503 || status === 502 ? (
        <div role="status" class="rounded-card border border-steel-200 bg-surface p-5 text-sm text-ink-700">
          <p class="font-medium text-ink-900">No pudimos cargar el seguimiento</p>
          <p class="mt-1">Revisa tu conexión y vuelve a intentarlo en unos segundos.</p>
        </div>
      ) : (
        <div role="status" class="rounded-card border border-steel-200 bg-surface p-5 text-sm text-ink-700">
          <p class="font-medium text-ink-900">Este enlace ya no está disponible</p>
          <p class="mt-1">Puede haber vencido o haber sido revocado. Pide a quien te lo envió que te comparta uno nuevo.</p>
        </div>
      )}
    </main>
    <footer class="border-t border-steel-200/70 py-5 text-center text-xs text-ink-500">
      Seguimiento con <a class="font-medium text-petrol-700 underline-offset-2 hover:underline" href="/">OnCargo</a>, fletes entre Lima y la sierra sur · <a class="underline-offset-2 hover:underline" href="/privacidad">Privacidad</a>
    </footer>
  </div>
</Base>
