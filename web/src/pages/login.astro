---
import Public from '@/layouts/Public.astro';
import LoginForm from '@/features/auth/components/LoginForm';
const next = Astro.url.searchParams.get('next') ?? undefined;
const expired = Astro.url.searchParams.has('expired');
---
<Public title="Ingresar">
  <div class="mx-auto w-full max-w-md px-4 py-10">
    <div class="rounded-card border border-steel-200 bg-surface p-6 shadow-sm">
      <h1 class="text-xl font-semibold">Ingresa a tu cuenta</h1>
      <p class="mb-5 mt-1 text-sm text-ink-500">Gestiona tus cargas, ofertas y envíos.</p>
      <LoginForm client:load next={next} expired={expired} />
      <p class="mt-5 text-center text-sm text-ink-500">¿Aún no tienes cuenta? <a class="font-medium text-petrol-700 underline" href="/registro">Regístrate</a></p>
    </div>
  </div>
</Public>
