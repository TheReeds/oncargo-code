---
import AppShell from '@/components/layout/AppShell.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import { Alert } from '@/components/ui/alert';
import OperatorListing from '@/features/operator/components/OperatorListing';
import { getMetrics, listShipments, type OperatorListQuery } from '@/features/operator/server';
import { getCatalog } from '@/features/catalog/server';
const t = Astro.locals.session!.token;
const q = Astro.url.searchParams;
const get = (k: string) => q.get(k) ?? '';
const filters = { status: get('estado'), origin: get('origen'), dest: get('destino'), from: get('desde'), to: get('hasta'), q: get('q').trim().slice(0, 60) };
const pageNo = Math.max(1, Number(get('pagina')) || 1);
const { cities } = await getCatalog();
let result = { items: [] as Awaited<ReturnType<typeof listShipments>>['items'], meta: { page: 0, size: 20, total: 0 } };
let loadError: string | null = null;
let counts: Record<string, number> | undefined;
try {
  const m = await getMetrics(t).catch(() => null);
  if (m) counts = { PENDING: m.shipmentsPending ?? 0, IN_TRANSIT: m.shipmentsInTransit ?? 0, DELIVERED: m.shipmentsDelivered ?? 0 };
  const query: OperatorListQuery = {
    status: filters.status || undefined, originCity: filters.origin || undefined, destinationCity: filters.dest || undefined,
    fromDate: filters.from || undefined, toDate: (filters.to || filters.from) || undefined, q: filters.q.length >= 2 ? filters.q : undefined, page: pageNo - 1, size: 20,
  };
  result = await listShipments(t, query);
} catch (e) {
  loadError = e instanceof Error ? e.message : 'No pudimos cargar el listado.';
}
---
<AppShell title="Envíos" active="operador-envios" wide>
  <PageHeader title="Envíos" subtitle="Todos los envíos de la plataforma, del más reciente al más antiguo." breadcrumbs={[{ label: 'Panel de operación', href: '/operador' }, { label: 'Envíos' }]} />
  {loadError && <Alert tone="error" title="No pudimos cargar el listado" className="mb-4">{loadError} Recarga la página para intentarlo de nuevo.</Alert>}
  <OperatorListing client:load kind="shipments" rows={result.items} cities={cities} filters={filters} page={result.meta.page + 1} size={result.meta.size} total={result.meta.total} counts={counts} />
</AppShell>
