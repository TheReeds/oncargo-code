---
import AppShell from '@/components/layout/AppShell.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import { Card, CardBody, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
import { Alert } from '@/components/ui/alert';
import { DescriptionList } from '@/components/ui/description-list';
import { buttonVariants } from '@/components/ui/button';
import { StatusPill } from '@/components/domain/StatusPill';
import { RouteLine } from '@/components/domain/RouteLine';
import { Badge } from '@/components/ui/badge';
import { StopTimeline } from '@/features/shipments/components/StopTimeline';
import DocumentsPanel from '@/features/documents/components/DocumentsPanel';
import OperatorChat from '@/features/operator/components/OperatorChat';
import ShipmentIncidents from '@/features/incidents/components/ShipmentIncidents';
import { getShipment } from '@/features/operator/server';
import ShipmentActions from '@/features/shipments/components/ShipmentActions';
import SettlementCard from '@/features/settlements/components/SettlementCard';
import AdjustmentsPanel from '@/features/shipments/components/AdjustmentsPanel';
import { ShipmentFacts } from '@/features/shipments/components/ShipmentExtras';
import { ApiError } from '@/lib/api/client';
import { CITY_LABELS, formatDate, formatDateTime, formatMoney, formatTons } from '@/lib/format';
import { TriangleAlert } from '@lucide/astro';

const { id } = Astro.params;
let s;
try {
  s = await getShipment(Astro.locals.session!.token, id!);
} catch (e) {
  if (e instanceof ApiError && [400, 403, 404].includes(e.status)) return Astro.redirect('/operador');
  throw e;
}
const route = `${CITY_LABELS[s.originCity ?? ''] ?? s.originCity} → ${CITY_LABELS[s.destinationCity ?? ''] ?? s.destinationCity}`;
const stops = s.stops ?? [];
const done = stops.filter((x) => x.status === 'COMPLETED').length;
---
<AppShell title="Detalle de envío" active="operador-envios" wide>
  <PageHeader title={route} subtitle={`Envío creado ${formatDateTime(s.createdAt)}${s.deliveredAt ? ` · entregado ${formatDateTime(s.deliveredAt)}` : ''}. Vista de consulta con acciones del operador.`}
    breadcrumbs={[{ label: 'Panel de operación', href: '/operador' }, { label: 'Envíos', href: '/operador/envios' }, { label: route }]}>
    <Fragment slot="meta">
      <StatusPill status={s.status!} />
      {s.hasActiveIncident && <Badge tone="red"><TriangleAlert size={12} aria-hidden="true" />Con incidencia activa</Badge>}
      <span class="font-mono text-xs">ID {s.id!.slice(0, 8)}</span>
    </Fragment>
    {s.requestId && <a slot="actions" href={`/operador/solicitudes/${s.requestId}`} class={buttonVariants({ variant: 'outline' })}>Ver solicitud de origen</a>}
  </PageHeader>

  {s.hasActiveIncident && (
    <Alert tone="warning" title="Envío detenido por una incidencia" className="mb-4">
      El conductor no puede avanzar las paradas hasta que se resuelva o se cierre (RN11). Gestiónala en <a class="font-medium underline" href="/operador/incidencias">Incidencias</a>.
    </Alert>
  )}

  <div class="mb-6 space-y-4">
    <ShipmentFacts client:load shipment={s} perspective="OPERATOR" />
    <ShipmentActions client:load shipment={s} perspective="OPERATOR" />
  </div>

  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_340px]">
    <div class="flex min-w-0 flex-col gap-6">
      <Card>
        <CardHeader>
          <div><CardTitle>Ruta y paradas</CardTitle><CardDescription>{stops.length ? `${done} de ${stops.length} paradas completadas` : 'Recojo y entrega del envío'}</CardDescription></div>
        </CardHeader>
        <CardBody className="space-y-5">
          <RouteLine origin={s.originCity!} destination={s.destinationCity!} />
          <p class="rounded-input bg-steel-100 px-3 py-2.5 text-sm text-ink-700">{s.cargoDescription}</p>
          <StopTimeline stops={stops} />
        </CardBody>
      </Card>
      {s.requestId && <OperatorChat client:load requestId={s.requestId} />}
      <ShipmentIncidents client:load shipmentId={s.id!} />
      <DocumentsPanel client:load shipmentId={s.id!} perspective="OPERATOR" status={s.status!} hasActiveIncident={s.hasActiveIncident ?? false} />
      <SettlementCard client:load shipmentId={s.id!} perspective="OPERATOR" shipmentStatus={s.status} />
      <Card><CardBody><AdjustmentsPanel client:load shipment={s} perspective="OPERATOR" /></CardBody></Card>
    </div>
    <Card className="self-start">
      <CardHeader><CardTitle>Resumen</CardTitle></CardHeader>
      <CardBody className="space-y-5">
        <DescriptionList cols={1} items={[
          { label: 'PYME', value: s.requesterName },
          { label: 'Transportista', value: s.carrierName },
          { label: 'Vehículo', value: s.vehiclePlate, mono: true },
          { label: 'Conductor', value: s.driverName ?? 'Sin asignar' },
          { label: 'Peso', value: formatTons(s.weightKg), mono: true },
          { label: 'Recojo', value: s.pickupDate ? formatDate(s.pickupDate) : undefined },
        ]} />
        <div class="flex items-baseline justify-between gap-3 border-t border-steel-200 pt-4"><span class="text-sm text-ink-500">Precio acordado</span><span class="money text-lg">{formatMoney(s.agreedPrice)}</span></div>
      </CardBody>
    </Card>
  </div>
</AppShell>
