---
import AppShell from '@/components/layout/AppShell.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import IncidentsList from '@/features/incidents/components/IncidentsList';
import { routesFor } from '@/features/incidents/server';
const s = Astro.locals.session!;
const routes = await routesFor(s.token, s.orgType);
---
<AppShell title="Incidencias" active="operador-incidencias" wide>
  <PageHeader title="Incidencias" subtitle="Bandeja global. Las activas van primero y las más antiguas arriba: ámbar pasadas 12 h, rojo pasadas 24 h." />
  <IncidentsList client:load variant="operator" routes={routes} />
</AppShell>
