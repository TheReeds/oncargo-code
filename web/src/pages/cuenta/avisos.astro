---
import AppShell from '@/components/layout/AppShell.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import NotificationPreferences from '@/features/notifications/components/NotificationPreferences';
import EmailSettingsCard from '@/features/notifications/components/EmailSettingsCard';
import { Alert } from '@/components/ui/alert';
import { getEmailSettings, getPreferences } from '@/features/notifications/server';
const session = Astro.locals.session!;
const [prefs, email] = await Promise.all([
  getPreferences(session.token).catch(() => null),
  getEmailSettings(session.token).catch(() => null),
]);
---
<AppShell title="Mis avisos" active="cuenta">
  <PageHeader title="Mis avisos" subtitle="Elige qué avisos recibes y por dónde. Es solo para ti: tus compañeros tienen sus propias preferencias."
    breadcrumbs={[{ label: 'Mi cuenta', href: '/cuenta' }, { label: 'Mis avisos' }]} />
  <div class="space-y-5">
    {prefs ? <NotificationPreferences client:load initial={prefs as never} /> : <Alert tone="error" title="No pudimos cargar tus avisos">Recarga la página en unos segundos.</Alert>}
    {email && <EmailSettingsCard client:load initial={email as never} />}
  </div>
</AppShell>
