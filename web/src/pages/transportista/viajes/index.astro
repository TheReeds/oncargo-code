---
import LiveRegion from '@/components/ui/live-region';
import AppShell from '@/components/layout/AppShell.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import { Alert } from '@/components/ui/alert';
import { KpiGrid, KpiTile } from '@/components/domain/KpiTile';
import { buttonVariants } from '@/components/ui/button';
import MyTripsTable from '@/features/trips/components/MyTripsTable';
import { listMyTrips, type TripView } from '@/features/trips/server';
import { formatTons } from '@/lib/format';
import { Plus } from '@lucide/astro';
import { can } from '@/lib/permissions';
import { ReadOnlyNotice } from '@/components/domain/ReadOnlyNotice';
import { CalendarClock, Route, PackageCheck, Weight } from 'lucide-react';
const canOperate = can(Astro.locals.session, 'OPERATE');
let trips: TripView[] = [];
let loadError: string | null = null;
try {
  trips = await listMyTrips(Astro.locals.session!.token);
} catch (e) {
  loadError = e instanceof Error ? e.message : 'No pudimos cargar tus viajes.';
}
const active = trips.filter((t) => t.status === 'OPEN' || t.status === 'FILLING');
const pending = trips.reduce((n, t) => n + (t.pendingBookings ?? 0), 0);
const confirmed = active.reduce((n, t) => n + (t.confirmedBookings ?? 0), 0);
const freeKg = active.reduce((n, t) => n + (t.remainingKg ?? 0), 0);
---
<AppShell title="Viajes" active="viajes">
  <PageHeader title="Viajes" subtitle="Publica tus salidas con espacio libre y deja que las empresas reserven.">
    {canOperate && <a slot="actions" href="/transportista/viajes/nuevo" class={buttonVariants({ variant: 'money' })}><Plus size={16} /> Publicar viaje</a>}
  </PageHeader>
  {loadError && <Alert tone="error" title="No pudimos cargar tus viajes" className="mb-4">{loadError} Recarga la página para intentarlo de nuevo.</Alert>}
  <ReadOnlyNotice client:load className="mb-4">No puedes publicar viajes.</ReadOnlyNotice>
  <LiveRegion client:load types={['trip_booking.updated', 'trip.cancelled']} region="trips" />
  <div data-live-region="trips" class="space-y-5">
    {trips.length > 0 && (
      <KpiGrid>
        <KpiTile label="Viajes abiertos" value={active.length} context="con espacio para reservar" icon={CalendarClock} tone="petrol" />
        <KpiTile label="Por confirmar" value={pending} context={pending ? 'reservas esperan tu respuesta' : 'todo al día'} icon={Route} tone={pending ? 'warn' : 'default'} />
        <KpiTile label="Reservas confirmadas" value={confirmed} context="en viajes abiertos" icon={PackageCheck} tone="money" />
        <KpiTile label="Espacio libre" value={formatTons(freeKg)} context="por vender en viajes abiertos" icon={Weight} tone="money" />
      </KpiGrid>
    )}
    {!loadError && <MyTripsTable client:load trips={trips} />}
  </div>
</AppShell>
