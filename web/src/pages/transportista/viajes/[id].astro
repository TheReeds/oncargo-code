---
import { buttonVariants } from '@/components/ui/button';
import AppShell from '@/components/layout/AppShell.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import { Alert } from '@/components/ui/alert';
import TripDetail from '@/features/trips/components/TripDetail';
import { getTrip, listTripBookings } from '@/features/trips/server';
import { ApiError } from '@/lib/api/client';
import { CITY_LABELS } from '@/lib/format';
import { can } from '@/lib/permissions';
import ActivityTrail from '@/features/activity/components/ActivityTrail';
const token = Astro.locals.session!.token;
const { id } = Astro.params;
let trip, bookings;
let loadError: string | null = null;
try {
  [trip, bookings] = await Promise.all([getTrip(token, id!), listTripBookings(token, id!)]);
} catch (e) {
  if (e instanceof ApiError && (e.status === 404 || e.status === 400)) return Astro.redirect('/transportista/viajes');
  loadError = e instanceof Error ? e.message : 'No pudimos cargar el viaje.';
}
const routeLabel = trip ? `${CITY_LABELS[trip.originCity!]} → ${CITY_LABELS[trip.destinationCity!]}` : 'Detalle del viaje';
---
<AppShell title="Detalle del viaje" active="viajes">
  <PageHeader title={trip ? `Viaje ${routeLabel}` : 'Detalle del viaje'} subtitle="Confirma o rechaza las reservas y controla la ocupación." breadcrumbs={[{ label: 'Viajes', href: '/transportista/viajes' }, { label: routeLabel }]}>
    {trip && can(Astro.locals.session, 'OPERATE') && <a slot="actions" href={`/transportista/viajes/nuevo?from=${trip.id}`} class={buttonVariants({ variant: 'outline' })}>Duplicar viaje</a>}
    <a slot="actions" href="/transportista/viajes" class={buttonVariants({ variant: 'outline' })}>Volver a viajes</a>
  </PageHeader>
  {loadError && <Alert tone="error" title="No pudimos cargar el viaje">{loadError} Recarga la página para intentarlo de nuevo.</Alert>}
  {trip && <TripDetail client:load trip={trip} bookings={bookings ?? []} />}
  {trip && <div class="mt-6 max-w-2xl"><ActivityTrail client:load subject="TRIP" id={trip.id!} title="Actividad del viaje" liveTypes={['trip_booking.updated', 'trip.cancelled']} /></div>}
</AppShell>
