---
import AppShell from '@/components/layout/AppShell.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import { Card } from '@/components/ui/card';
import { Table, Td, Th, Tr } from '@/components/ui/table';
import { StatusPill } from '@/components/domain/StatusPill';
import { EmptyState } from '@/components/domain/EmptyState';
import { Countdown } from '@/components/domain/Countdown';
import { listMyBids } from '@/features/marketplace/server';
import { CARGO_LABELS, CITY_LABELS, formatDate, formatDateTime, formatMoney, formatTons } from '@/lib/format';
import { diffPct } from '@/features/requests/components/BidComparison';
const rows = (await listMyBids(Astro.locals.session!.token)).filter((r) => r.myBid).sort((a, b) => (b.myBid!.createdAt ?? '').localeCompare(a.myBid!.createdAt ?? ''));
---
<AppShell title="Mis ofertas" active="ofertas">
  <PageHeader title="Mis ofertas" subtitle="Seguimiento de tus ofertas en subasta" />
  <Card>
    {rows.length === 0 ? (
      <EmptyState title="Aún no has enviado ofertas" description="Explora el marketplace y ofrece tu mejor precio." />
    ) : (
      <Table>
        <thead><tr><Th>Ruta</Th><Th>Carga</Th><Th>Recojo</Th><Th className="text-right">Mi oferta</Th><Th className="text-right">vs. sugerido</Th><Th>Estado</Th><Th>Subasta</Th></tr></thead>
        <tbody>
          {rows.map((r) => {
            const d = diffPct(r.myBid!.amount ?? 0, r.suggestedPrice);
            return (
              <Tr>
                <Td><div class="font-medium">{CITY_LABELS[r.originCity!]} → {CITY_LABELS[r.destinationCity!]}</div><div class="text-xs text-ink-500">Enviada {formatDateTime(r.myBid!.createdAt)}</div></Td>
                <Td>{CARGO_LABELS[r.cargoType!]} · <span class="font-mono">{formatTons(r.weightKg)}</span></Td>
                <Td className="whitespace-nowrap">{formatDate(r.pickupDate)}</Td>
                <Td className="text-right"><span class="money text-base">{formatMoney(r.myBid!.amount)}</span></Td>
                <Td className={`whitespace-nowrap text-right font-mono tabular-nums ${d != null && d <= 0 ? 'text-emerald-700' : 'text-amber-700'}`}>{d == null ? '—' : `${d > 0 ? '+' : ''}${d.toFixed(1)}%`}</Td>
                <Td><StatusPill status={r.myBid!.status!} kind="bid" /></Td>
                <Td className="whitespace-nowrap">{r.auction?.status === 'OPEN' ? <div><span class="font-mono text-xs">{r.auction.bidCount}/{r.auction.maxBids}</span> <Countdown client:load closesAt={r.auction.closesAt} /></div> : <span class="text-ink-500">Cerrada</span>}</Td>
              </Tr>
            );
          })}
        </tbody>
      </Table>
    )}
  </Card>
</AppShell>
