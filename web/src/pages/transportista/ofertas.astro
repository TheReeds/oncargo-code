---
import LiveRegion from '@/components/ui/live-region';
import AppShell from '@/components/layout/AppShell.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import { Gavel, Clock, CircleCheck, CircleX } from 'lucide-react';
import { KpiGrid, KpiTile } from '@/components/domain/KpiTile';
import { Alert } from '@/components/ui/alert';
import { buttonVariants } from '@/components/ui/button';
import { listMyBids } from '@/features/marketplace/server';
import MyBidsTable from '@/features/marketplace/components/MyBidsTable';
import { formatMoney } from '@/lib/format';
import { bidState } from '@/features/marketplace/bid-state';
let rows: Awaited<ReturnType<typeof listMyBids>> = [];
let loadError: string | null = null;
try {
  rows = (await listMyBids(Astro.locals.session!.token)).filter((r) => r.myBid).sort((a, b) => (b.myBid!.createdAt ?? '').localeCompare(a.myBid!.createdAt ?? ''));
} catch (e) {
  loadError = e instanceof Error ? e.message : 'No pudimos cargar tus ofertas.';
}
const openRequestId = Astro.url.searchParams.get('solicitud');
const by = (s: string) => rows.filter((r) => bidState(r) === s);
const pending = by('PENDING').length;
const accepted = by('ACCEPTED');
const lost = by('LOST').length;
const won = accepted.reduce((n, r) => n + (r.myBid!.amount ?? 0), 0);
---
<AppShell title="Mis ofertas" active="ofertas">
  <PageHeader title="Mis ofertas" subtitle="Sigue el estado de cada oferta, cuánto falta para que cierre su subasta y responde las contra-ofertas.">
    <a slot="actions" href="/transportista/marketplace" class={buttonVariants({ variant: 'money' })}><Gavel size={16} /> Buscar cargas para ofertar</a>
  </PageHeader>
  <LiveRegion client:load types={['bid.accepted', 'bid.rejected', 'bid.placed', 'counter_offer.updated']} region="ofertas" />
  <div data-live-region="ofertas">
    {loadError && <Alert tone="error" title="No pudimos cargar tus ofertas" className="mb-4">{loadError} Recarga la página para intentarlo de nuevo.</Alert>}
    {rows.length > 0 && (
      <KpiGrid className="mb-5">
        <KpiTile label="Ofertas enviadas" value={rows.length} context="en total" icon={Gavel} />
        <KpiTile label="Pendientes" value={pending} context={pending ? 'esperan respuesta de la PYME' : 'ninguna por ahora'} icon={Clock} tone="warn" />
        <KpiTile label="Aceptadas" value={accepted.length} context={accepted.length ? `${formatMoney(won)} adjudicados` : 'aún ninguna'} icon={CircleCheck} tone="money" href={accepted.length ? '/transportista/envios' : undefined} />
        <KpiTile label="Perdidas" value={lost} context={lost ? 'otra oferta fue elegida' : 'ninguna por ahora'} icon={CircleX} tone={lost ? 'alert' : 'default'} />
      </KpiGrid>
    )}
    {!loadError && <MyBidsTable client:load rows={rows} openRequestId={openRequestId} />}
  </div>
</AppShell>
