---
import AppShell from '@/components/layout/AppShell.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import { Gavel, Clock, CircleCheck } from 'lucide-react';
import { KpiTile } from '@/components/domain/KpiTile';
import { buttonVariants } from '@/components/ui/button';
import { Card } from '@/components/ui/card';
import { Table, Td, Th, Tr } from '@/components/ui/table';
import { StatusPill } from '@/components/domain/StatusPill';
import { EmptyState } from '@/components/domain/EmptyState';
import { Countdown } from '@/components/domain/Countdown';
import { listMyBids } from '@/features/marketplace/server';
import { CARGO_LABELS, CITY_LABELS, formatDate, formatDateTime, formatMoney, formatTons, VEHICLE_LABELS } from '@/lib/format';
import { diffPct } from '@/features/requests/components/BidComparison';
const rows = (await listMyBids(Astro.locals.session!.token)).filter((r) => r.myBid).sort((a, b) => (b.myBid!.createdAt ?? '').localeCompare(a.myBid!.createdAt ?? ''));
const pending = rows.filter((r) => r.myBid!.status === 'PENDING').length;
const accepted = rows.filter((r) => r.myBid!.status === 'ACCEPTED').length;
---
<AppShell title="Mis ofertas" active="ofertas">
  <PageHeader title="Mis ofertas" subtitle="Sigue el estado de cada oferta y cuánto falta para que cierre su subasta." />
  {rows.length > 0 && (
    <div class="mb-6 grid gap-4 sm:grid-cols-3">
      <KpiTile label="Ofertas enviadas" value={rows.length} context="en total" icon={Gavel} />
      <KpiTile label="Pendientes" value={pending} context="esperando respuesta de la PYME" icon={Clock} />
      <KpiTile label="Aceptadas" value={accepted} context={accepted ? "ya son envíos tuyos" : "aún ninguna"} icon={CircleCheck} />
    </div>
  )}
  <Card>
    {rows.length === 0 ? (
      <>
      <EmptyState title="Todavía no has enviado ofertas" description="Revisa las cargas disponibles y oferta por las compatibles con tu flota." />
      <div class="-mt-6 pb-10 text-center"><a href="/transportista/marketplace" class={buttonVariants()}>Ver cargas disponibles</a></div>
      </>
    ) : (
      <Table>
        <thead><tr><Th>Ruta</Th><Th>Carga</Th><Th>Recojo</Th><Th className="text-right">Mi oferta</Th><Th className="text-right">vs. sugerido</Th><Th>Vehículo</Th><Th>Estado</Th><Th>Subasta</Th></tr></thead>
        <tbody>
          {rows.map((r) => {
            const d = diffPct(r.myBid!.amount ?? 0, r.suggestedPrice);
            return (
              <Tr>
                <Td><div class="font-medium">{CITY_LABELS[r.originCity!]} → {CITY_LABELS[r.destinationCity!]}</div><div class="text-xs text-ink-500">Enviada {formatDateTime(r.myBid!.createdAt)}</div></Td>
                <Td>{CARGO_LABELS[r.cargoType!]} · <span class="font-mono">{formatTons(r.weightKg)}</span></Td>
                <Td className="whitespace-nowrap">{formatDate(r.pickupDate)}</Td>
                <Td className="text-right"><span class="money text-base">{formatMoney(r.myBid!.amount)}</span></Td>
                <Td className={`whitespace-nowrap text-right font-mono tabular-nums ${d != null && d <= 0 ? 'text-emerald-700' : 'text-amber-700'}`}>{d == null ? '—' : `${d > 0 ? '+' : ''}${d.toFixed(1)}%`}</Td>
                <Td className="whitespace-nowrap">{r.myBid!.vehiclePlate ? <><div class="font-mono">{r.myBid!.vehiclePlate}</div><div class="text-xs text-ink-500">{r.myBid!.vehicleType ? VEHICLE_LABELS[r.myBid!.vehicleType] : ""}</div></> : <span class="text-ink-500">—</span>}</Td>
                <Td><StatusPill status={r.myBid!.status!} kind="bid" /></Td>
                <Td className="whitespace-nowrap">{r.auction?.status === 'OPEN' ? <div><span class="font-mono text-xs">{r.auction.bidCount}/{r.auction.maxBids}</span> <Countdown client:load closesAt={r.auction.closesAt} /></div> : <span class="text-ink-500">Cerrada</span>}</Td>
              </Tr>
            );
          })}
        </tbody>
      </Table>
    )}
  </Card>
</AppShell>
