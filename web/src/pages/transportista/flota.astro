---
import AppShell from '@/components/layout/AppShell.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import FleetManager from '@/features/fleet/components/FleetManager';
import { listDrivers, listVehicles } from '@/features/fleet/server';
const t = Astro.locals.session!.token;
const [vehicles, drivers] = await Promise.all([listVehicles(t), listDrivers(t)]);
---
<AppShell title="Flota" active="flota">
  <PageHeader title="Flota" subtitle="Administra tus vehículos y conductores. Solo los vehículos disponibles pueden ofertar." />
  <FleetManager client:load vehicles={vehicles} drivers={drivers} />
</AppShell>
