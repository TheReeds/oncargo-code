---
import AppShell from '@/components/layout/AppShell.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import { KpiTile, KpiGrid } from '@/components/domain/KpiTile';
import { EmptyState } from '@/components/domain/EmptyState';
import { RouteLine } from '@/components/domain/RouteLine';
import { StatusPill } from '@/components/domain/StatusPill';
import { Card, CardHeader, CardTitle, CardDescription } from '@/components/ui/card';
import { buttonVariants } from '@/components/ui/button';
import TrackingMap from '@/features/shipments/components/TrackingMap';
import AttentionList from '@/features/requests/components/AttentionList';
import { pymeDashboard } from '@/features/dashboard/server';
import { getCatalog } from '@/features/catalog/server';
import { formatMoney } from '@/lib/format';
import { TriangleAlert, Plus, Search, ArrowRight } from '@lucide/astro';
import { FileText, Gavel, Truck, PackageCheck, BookmarkCheck } from 'lucide-react';

const { session } = Astro.locals;
const [d, { cities }] = await Promise.all([pymeDashboard(session!.token), getCatalog()]);
const k = d.kpis;
const progress = (s: (typeof d.ongoing)[number]) => {
  const stops = s.stops ?? [];
  return { done: stops.filter((x) => x.status === 'COMPLETED').length, total: stops.length };
};
---
<AppShell title="Panel" active="panel">
  <PageHeader title="Panel" subtitle="Resumen de tus solicitudes y envíos">
    <a slot="actions" href="/pyme/solicitudes/nueva" class={buttonVariants()}><Plus size={16} /> Publicar solicitud</a>
  </PageHeader>

  <KpiGrid>
    <KpiTile label="Solicitudes activas" value={k.active} tone="petrol" context={k.active ? `${k.closingSoon} con subasta abierta` : 'Publica tu primera carga'} icon={FileText} href="/pyme/solicitudes" />
    <KpiTile label="Ofertas por revisar" value={k.offersToReview} tone={k.offersToReview ? 'warn' : 'default'} context={k.offersToReview ? `en ${k.requestsWithBids} solicitud${k.requestsWithBids === 1 ? '' : 'es'}` : 'Nada pendiente'} icon={Gavel} href="/pyme/solicitudes" />
    <KpiTile label="Envíos en tránsito" value={k.inTransit} tone="petrol" context={`${k.toPickup} por recoger`} icon={Truck} href="/pyme/envios" />
    <KpiTile label="Entregados del mes" value={k.deliveredMonth} tone="money" context="este mes" icon={PackageCheck} href="/pyme/envios" />
  </KpiGrid>

  <div class="mt-5 grid gap-5 xl:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)]">
    <div class="min-w-0 space-y-5">
      <Card>
        <CardHeader>
          <div class="min-w-0">
            <CardTitle className="flex items-center gap-2"><TriangleAlert size={16} class="text-amber-700" /> Requiere tu atención</CardTitle>
            <CardDescription>Subastas con ofertas que aún no eliges</CardDescription>
          </div>
          {d.attentionTotal > 0 && <span class="rounded-full bg-amber-50 px-2 py-0.5 font-mono text-xs font-semibold text-amber-700">{d.attentionTotal}</span>}
        </CardHeader>
        <AttentionList client:load items={d.attention} total={d.attentionTotal} />
      </Card>

      <Card>
        <div class="flex flex-wrap items-center justify-between gap-3 px-4 py-3.5 sm:px-5">
          <a href="/pyme/reservas" class="group flex min-w-0 items-center gap-3 rounded-input">
            <span class="grid size-9 shrink-0 place-items-center rounded-input bg-petrol-50 text-petrol-700"><BookmarkCheck size={17} /></span>
            <span class="min-w-0">
              <span class="block text-[13px] font-medium text-ink-500">Reservas activas</span>
              <span class="flex items-baseline gap-2"><span class="font-mono text-2xl font-semibold tabular-nums text-ink-900">{k.activeTripBookings}</span><span class="text-xs text-ink-500">{k.activeTripBookings ? 'en viajes de transportistas' : 'Aún sin reservas'}</span></span>
            </span>
          </a>
          <div class="flex items-center gap-3">
            <p class="hidden max-w-56 text-xs text-ink-500 md:block">¿Tu carga es pequeña? Reserva solo el espacio que necesitas en un viaje que ya sale.</p>
            <a href="/pyme/viajes" class={buttonVariants({ variant: 'outline', size: 'sm' })}><Search size={14} /> Buscar viajes</a>
          </div>
        </div>
      </Card>
    </div>

    <Card className="min-w-0 self-start">
      <CardHeader>
        <div class="min-w-0"><CardTitle>Envíos en curso</CardTitle><CardDescription>{d.ongoing.length ? `${d.ongoing.length} envío${d.ongoing.length === 1 ? '' : 's'} por recoger o en ruta` : 'Seguimiento en vivo'}</CardDescription></div>
        <a href="/pyme/envios" class="inline-flex items-center gap-1 text-sm font-medium text-petrol-700 hover:underline">Ver seguimiento <ArrowRight size={14} /></a>
      </CardHeader>
      {d.ongoing.length === 0 ? (
        <EmptyState compact title="Sin envíos en curso" description="Cuando aceptes una oferta, podrás seguir tu carga aquí." />
      ) : (
        <div>
          <div class="p-3 pb-0"><TrackingMap client:only="react" shipments={d.ongoing} cities={cities} height={210} /></div>
          <ul class="divide-y divide-steel-200" aria-label="Envíos en curso">
            {d.ongoing.slice(0, 4).map((s) => {
              const p = progress(s);
              return (
                <li><a href={`/pyme/envios?id=${s.id}`} class="block space-y-2 px-4 py-3 hover:bg-steel-100/60 sm:px-5">
                  <div class="flex items-center justify-between gap-3">
                    <div class="min-w-0 flex-1"><RouteLine size="sm" origin={s.originCity!} destination={s.destinationCity!} /></div>
                    <StatusPill status={s.status!} />
                  </div>
                  <div class="flex items-center justify-between gap-3 text-xs text-ink-500">
                    <span class="min-w-0 truncate">{s.carrierName}{s.driverName ? ` · ${s.driverName}` : ' · Sin conductor'}</span>
                    <span class="flex shrink-0 items-center gap-2">
                      {p.total > 0 && <span class="font-mono tabular-nums" title="Paradas completadas">{p.done}/{p.total} paradas</span>}
                      <span class="money text-xs">{formatMoney(s.agreedPrice)}</span>
                    </span>
                  </div>
                </a></li>
              );
            })}
          </ul>
          {d.ongoing.length > 4 && <div class="border-t border-steel-200 px-5 py-3 text-sm"><a href="/pyme/envios" class="font-medium text-petrol-700 hover:underline">Ver los {d.ongoing.length} envíos</a></div>}
        </div>
      )}
    </Card>
  </div>
</AppShell>
