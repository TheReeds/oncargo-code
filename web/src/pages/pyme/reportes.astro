---
import AppShell from '@/components/layout/AppShell.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import { ExportButton } from '@/components/ui/export-button';
import ReportView from '@/features/reports/components/ReportView';
import { getOverview } from '@/features/reports/server';
const token = Astro.locals.session!.token;
const from = Astro.url.searchParams.get('desde') ?? '';
const to = Astro.url.searchParams.get('hasta') ?? '';
let overview: Awaited<ReturnType<typeof getOverview>> | null = null;
let error: string | null = null;
try {
  overview = await getOverview(token, from, to);
} catch (e) {
  error = e instanceof Error ? e.message : 'No pudimos cargar el reporte.';
}
const range = { from: from ? overview?.from ?? from : '', to: from ? overview?.to ?? to : '' };
---
<AppShell title="Reportes" active="reportes">
  <PageHeader title="Reportes" subtitle="Cuánto gastas, cuánto ahorras frente al precio sugerido y cuánto te cuesta cada kg." >
    <ExportButton client:load slot="actions" size="default" href={`/exportar/reportes${range.from ? `?desde=${range.from}&hasta=${range.to}` : ''}`} />
  </PageHeader>
  <ReportView client:load perspective="PYME" overview={overview} error={error} range={range} base="/pyme/reportes" />
</AppShell>
