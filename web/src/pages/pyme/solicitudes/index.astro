---
import AppShell from '@/components/layout/AppShell.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import RequestsTable from '@/features/requests/components/RequestsTable';
import { listMine } from '@/features/requests/server';
import { Plus } from '@lucide/astro';
import { can } from '@/lib/permissions';
const session = Astro.locals.session!;
const requests = await listMine(session.token);
const canOperate = can(session, 'OPERATE');
---
<AppShell title="Solicitudes" active="solicitudes">
  <PageHeader title="Solicitudes" subtitle="Tus cargas publicadas y su subasta">
    {canOperate && <a slot="actions" href="/pyme/solicitudes/nueva" class="inline-flex h-10 items-center gap-2 rounded-input bg-petrol-700 px-4 text-sm font-medium text-on-solid hover:bg-petrol-800"><Plus size={16} /> Publicar solicitud</a>}
  </PageHeader>
  <RequestsTable client:load requests={requests} />
</AppShell>
