---
import AppShell from '@/components/layout/AppShell.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import { Card, CardBody, CardHeader, CardTitle } from '@/components/ui/card';
import { Alert } from '@/components/ui/alert';
import { RouteLine } from '@/components/domain/RouteLine';
import BidComparison from '@/features/requests/components/BidComparison';
import { AuctionCard, RequestHeaderActions, RequestLiveSync } from '@/features/requests/components/RequestLive';
import NegotiationPanel from '@/features/negotiation/components/NegotiationPanel';
import { listThreads } from '@/features/negotiation/server';
import { getRequest, listBids } from '@/features/requests/server';
import { ApiError } from '@/lib/api/client';
import { CARGO_LABELS, VEHICLE_LABELS, formatDate, formatDateTime, formatMoney, formatTons } from '@/lib/format';

const { id } = Astro.params;
const token = Astro.locals.session!.token;
let r;
try {
  r = await getRequest(token, id!);
} catch (e) {
  if (e instanceof ApiError && (e.status === 404 || e.status === 403 || e.status === 400)) return Astro.redirect('/pyme/solicitudes');
  throw e;
}
const bids = await listBids(token, id!).catch((e) => { if (e instanceof ApiError && e.status !== 401) return []; throw e; });
const threads = await listThreads(token, id!).catch(() => []);
const hilo = Astro.url.searchParams.get('hilo');
const a = r.auction;
const created = Astro.url.searchParams.has('creada');
---
<AppShell title="Detalle de solicitud" active="solicitudes">
  <nav class="mb-3 text-sm text-ink-500" aria-label="Migas"><a class="rounded-sm hover:text-petrol-700 hover:underline" href="/pyme/solicitudes">Solicitudes</a> <span aria-hidden="true">/</span> <span class="text-ink-900" aria-current="page">Detalle</span></nav>
  <PageHeader title={`Solicitud ${r.id!.slice(0, 8)}`} subtitle={`Creada ${formatDateTime(r.createdAt)}`}>
    <div slot="actions" class="flex flex-wrap items-center gap-3"><RequestHeaderActions client:load requestId={r.id!} status={r.status!} verified={r.requesterRucVerified} /></div>
  </PageHeader>

  <RequestLiveSync client:load requestId={r.id!} />
  {created && <Alert tone="success" className="mb-4">Solicitud publicada. La subasta ya está abierta para los transportistas.</Alert>}

  <div class="grid gap-6 lg:grid-cols-[1fr_320px]">
    <div class="order-2 min-w-0 space-y-6 lg:order-1">
      <Card>
        <CardHeader><CardTitle>Envío</CardTitle></CardHeader>
        <CardBody className="space-y-5">
          <RouteLine origin={r.originCity!} destination={r.destinationCity!} km={r.distanceKm} originSub={r.originAddress} destinationSub={r.destinationAddress} />
          <dl class="grid grid-cols-2 gap-4 border-t border-steel-200 pt-4 text-sm sm:grid-cols-4">
            <div><dt class="text-xs font-medium text-ink-500">Carga</dt><dd class="font-medium">{CARGO_LABELS[r.cargoType!]}</dd></div>
            <div><dt class="text-xs font-medium text-ink-500">Peso</dt><dd class="font-mono font-medium">{formatTons(r.weightKg)}</dd></div>
            <div><dt class="text-xs font-medium text-ink-500">Volumen</dt><dd class="font-mono font-medium">{r.volumeM3 ? `${r.volumeM3} m³` : '—'}</dd></div>
            <div><dt class="text-xs font-medium text-ink-500">Recojo</dt><dd class="font-medium">{formatDate(r.pickupDate)}</dd></div>
            {r.minVehicleType && <div class="col-span-2 sm:col-span-4"><dt class="text-xs font-medium text-ink-500">Vehículo mínimo</dt><dd class="font-medium">{VEHICLE_LABELS[r.minVehicleType] ?? r.minVehicleType}</dd></div>}
            <div class="col-span-2 sm:col-span-4"><dt class="text-xs font-medium text-ink-500">Descripción</dt><dd class="text-ink-700">{r.cargoDescription}</dd></div>
          </dl>
        </CardBody>
      </Card>

      <BidComparison client:load bids={bids} suggested={r.suggestedPrice} requestId={r.id!} requestStatus={r.status!} floor={r.priceFloor} />
      <NegotiationPanel client:load requestId={r.id!} requestStatus={r.status!} initialThreads={threads} initialCarrierOrgId={hilo && threads.some((t) => t.carrierOrgId === hilo) ? hilo : null} />
    </div>

    <aside class="order-1 space-y-4 lg:order-2">
      <AuctionCard client:load auction={a ?? null} />
      <Card>
        <CardHeader><CardTitle>Precios de referencia</CardTitle></CardHeader>
        <CardBody className="space-y-3 text-sm">
          <div class="flex justify-between"><span class="text-ink-700">Sugerido</span><span class="money text-base">{formatMoney(r.suggestedPrice)}</span></div>
          <div class="flex justify-between"><span class="text-ink-700">Piso de subasta</span><span class="font-mono font-semibold tabular-nums text-ink-900">{formatMoney(r.priceFloor)}</span></div>
        </CardBody>
      </Card>
    </aside>
  </div>
</AppShell>
