---
import Public from '@/layouts/Public.astro';
import RegisterForm from '@/features/auth/components/RegisterForm';
import { getCatalog } from '@/features/catalog/server';
const { cities } = await getCatalog();
const t = Astro.url.searchParams.get('tipo');
---
<Public title="Crear cuenta">
  <div class="mx-auto w-full max-w-xl px-4 py-8">
    <div class="rounded-card border border-steel-200 bg-surface p-6 shadow-sm">
      <h1 class="text-xl font-semibold">Crea tu cuenta en LOGYX</h1>
      <p class="mb-5 mt-1 text-sm text-ink-500">Registra tu empresa para publicar cargas u ofertar como transportista.</p>
      <RegisterForm client:load cities={cities} initialType={t === 'transportista' ? 'CARRIER' : 'PYME'} />
      <p class="mt-5 text-center text-sm text-ink-500">¿Ya tienes cuenta? <a class="font-medium text-petrol-700 underline" href="/login">Ingresa</a></p>
    </div>
  </div>
</Public>
