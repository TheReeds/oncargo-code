---
import Public from '@/layouts/Public.astro';
import { Alert } from '@/components/ui/alert';
import { BadgeCheck, FileText, Mail, ShieldCheck, Truck } from '@lucide/astro';
import { SAFETY_SECTIONS } from '@/features/legal/safety-content';
import { SUPPORT_EMAIL } from '@/lib/contact';
import { breadcrumbJsonLd } from '@/features/landing/seo';

const summary = [
  { icon: BadgeCheck, t: 'Empresas revisadas', d: 'Revisamos el RUC y los datos de cada empresa en 1 día hábil.' },
  { icon: Truck, t: 'El transportista responde', d: 'Por la carga, según su póliza de seguro de transporte.' },
  { icon: ShieldCheck, t: 'Evidencia en cada envío', d: 'Recojo, entrega con foto y firma, e incidencias registradas.' },
];
---
<Public title="Seguridad y seguro" description="Qué revisa OnCargo, qué cubre el transportista con su póliza y cómo se reclama un daño o una pérdida. Borrador pendiente de revisión legal." jsonLd={breadcrumbJsonLd('Seguridad y seguro', '/seguridad')}>
  <header class="mk-dark relative isolate overflow-hidden">
    <div class="mk-grid absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="mx-auto w-full max-w-[1280px] px-4 pb-28 pt-12 sm:pb-32 sm:pt-16 lg:px-10 lg:pb-36 lg:pt-20">
      <p class="inline-flex items-center gap-1.5 rounded-full border border-amber-500/60 bg-chrome/40 px-3 py-1 text-xs font-semibold text-white"><FileText size={13} class="text-amber-500" aria-hidden="true" /> Borrador — pendiente de revisión legal</p>
      <h1 class="mk-display mt-5 max-w-[16ch] text-white">Seguridad y seguro</h1>
      <p class="mk-lead mt-5 text-base text-white/85 sm:text-lg">Qué revisa OnCargo, qué cubre el transportista y cómo se reclama.</p>
    </div>
  </header>

  <div class="mx-auto w-full max-w-[1280px] px-4 lg:px-10">
    <ul class="relative z-10 -mt-20 grid gap-3 sm:-mt-24 sm:grid-cols-3 sm:gap-4" aria-label="En resumen">
      {summary.map((s) => (
        <li class="mk-card rounded-card border border-steel-200 bg-surface p-5 shadow-lg shadow-chrome/10">
          <span class="grid size-9 place-items-center rounded-full bg-petrol-50 text-petrol-700"><s.icon size={18} aria-hidden="true" /></span>
          <p class="mt-3 text-[15px] font-semibold text-ink-900">{s.t}</p>
          <p class="mt-1 text-sm text-ink-500">{s.d}</p>
        </li>
      ))}
    </ul>

    <article class="min-w-0 max-w-[68ch] py-12 sm:py-16">
      <Alert tone="warning" title="Borrador — pendiente de revisión legal" className="mb-8">
        Este texto resume los <a href="/terminos" class="font-medium underline underline-offset-2">Términos y condiciones</a> y puede cambiar. Si hay diferencias, valen los términos.
      </Alert>
      <div class="space-y-9 text-[15px] leading-7 text-ink-700">
        {SAFETY_SECTIONS.map((s) => (
          <section id={s.id} class="scroll-mt-24" aria-labelledby={`${s.id}-t`}>
            <h2 id={`${s.id}-t`} class="mb-2 text-lg font-semibold text-ink-900">{s.h}</h2>
            {s.p.map((t) => <p class="mt-2 text-pretty first:mt-0">{t}</p>)}
            {s.list && <ul class="mt-3 list-disc space-y-1.5 pl-5">{s.list.map((t) => <li>{t}</li>)}</ul>}
          </section>
        ))}
      </div>
      <div class="mt-10 flex items-start gap-3 rounded-card border border-steel-200 bg-petrol-50 p-5">
        <Mail size={20} class="mt-0.5 shrink-0 text-petrol-700" aria-hidden="true" />
        <div class="text-sm">
          <p class="font-semibold text-ink-900">¿Tienes un caso?</p>
          <p class="mt-1 text-ink-700">Regístralo como incidencia en el envío. Si no puedes, escribe a <a href={`mailto:${SUPPORT_EMAIL}`} class="font-medium text-petrol-700 underline underline-offset-2">{SUPPORT_EMAIL}</a> con el código del envío.</p>
        </div>
      </div>
    </article>
  </div>
</Public>
